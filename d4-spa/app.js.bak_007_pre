function ico(k){
  return '<span class="uic"><svg width="18" height="18" viewBox="0 0 32 32" fill="none">'+
    '<circle cx="16" cy="16" r="14.4" stroke="#7C5CFF" stroke-width="1.1" opacity=".5"/>'+
    '<g stroke="#C8C2FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">'+
    ICONS[k]+"</g></svg></span>";
}
var FEMALE=["xiaomo","xiaojing","ruhua","qiuxiang"];
function avatarImg(s){
  var stem={xiaojing:"xiaojing",xiaomo:"xiaomo",bohu:"bohu",ruhua:"ruhua",qiuxiang:"qiuxiang",xiaoming:"xiaoming",huaan:"huaan",xiaoqiang:"xiaoqiang",shusheng:"shusheng",jqimao:"jiqimao"}[s.id];
  if(!stem)return faceIcon(s);
  var onerr='this.style.display="none";this.nextElementSibling&&(this.nextElementSibling.style.display="grid")';
  return '<span class="face-emoji">'+faceIcon(s)+'</span><img class="ava-img" src="avatars/'+stem+'.webp" alt="'+esc(s.name)+'" loading="lazy" onerror="'+onerr+'">';
}
function realAvatar(s){
  var stem={xiaojing:"xiaojing",xiaomo:"xiaomo",bohu:"bohu",ruhua:"ruhua",qiuxiang:"qiuxiang",xiaoming:"xiaoming",huaan:"huaan",xiaoqiang:"xiaoqiang",shusheng:"shusheng",jqimao:"jiqimao"}[s.id];
  if(!stem)return '<span class="face-emoji">'+faceIcon(s)+'</span>';
  return '<span class="face-emoji" style="display:none"></span><img class="ava-img" src="avatars/'+stem+'.webp" alt="'+esc(s.name)+'" loading="lazy">';
}
function faceIcon(s){
  var gid="fc_"+s.id, isF=FEMALE.indexOf(s.id)>=0;
  var c0=s.grad.split(",")[0], c1=s.grad.split(",")[1];
  var skin="#FFE2CB", hair="#3A2A47", suit="rgba(255,255,255,.94)";
  var neck='<rect x="21.4" y="24.2" width="5.2" height="6" rx="1.6" fill="'+skin+'"/>';
  var body='<path d="M11.5 42c.7-7.2 5.3-10.7 12.5-10.7S35.8 34.8 36.5 42z" fill="'+suit+'"/>';
  var person;
  if(isF){
    var backHair='<path d="M12.8 20.5C12.8 12.6 17.4 8.6 24 8.6s11.2 4 11.2 11.9l-.7 10.3c-.1 1-1.2 1.1-1.7.4L31.8 25h-15.6l-1 6.2c-.5.7-1.6.6-1.7-.4z" fill="'+hair+'"/>';
    var face='<circle cx="24" cy="19.6" r="7" fill="'+skin+'"/>';
    var bangs='<path d="M17.3 17.3c.4-6.3 3-8.8 6.7-8.8s6.3 2.5 6.7 8.8c-2.3-1.8-4.4-2.2-6.7-1.8-2.3-.4-4.4 0-6.7 1.8z" fill="'+hair+'"/>';
    person=backHair+neck+body+face+bangs;
  }else{
    var faceM='<circle cx="24" cy="19.9" r="7" fill="'+skin+'"/>';
    var shortHair='<path d="M16.7 19.4C17 12.7 20 9.8 24 9.8s7 2.9 7.3 9.6c-2.3-2.9-4.6-3.7-7.3-3.7s-5 .8-7.3 3.7z" fill="'+hair+'"/>';
    person=neck+body+faceM+shortHair;
  }
  return '<span class="face-emoji"><svg viewBox="0 0 48 48"><defs>'+
    '<linearGradient id="'+gid+'" x1="0" y1="0" x2="1" y2="1">'+
    '<stop offset="0" stop-color="'+c0+'"/><stop offset="1" stop-color="'+c1+'"/></linearGradient></defs>'+
    '<rect width="48" height="48" rx="11" fill="url(#'+gid+')"/>'+
    '<ellipse cx="24" cy="6" rx="26" ry="10" fill="rgba(255,255,255,.10)"/>'+
    person+"</svg></span>";
}
function statusDot(s){return '<i class="ava-dot st-'+s.status+'"></i>';}

/* ============ 工具 ============ */
var SVGNS="http://www.w3.org/2000/svg";
function $(s,r){return (r||document).querySelector(s)}
function $all(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))}
function staffById(id){return STAFF.filter(function(s){return s.id===id})[0]}
function esc(t){return String(t).replace(/[&<>"]/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function el(tag,cls,html){var e=document.createElement(tag);if(cls)e.className=cls;if(html!=null)e.innerHTML=html;return e}
function statusPill(st){
  var map={done:["p-done","已完成"],busy:["p-busy","执行中"],wait:["p-wait","待审批"],stop:["p-stop","未接入"]};
  var m=map[st]||map.busy;
  return '<span class="pill '+m[0]+'"><i></i>'+m[1]+"</span>";
}
function countTasks(st){return TASKS.filter(function(t){return t.status===st}).length}
function toast(msg){
  var t=$("#toast");t.textContent=msg;t.classList.add("on");
  clearTimeout(t._t);t._t=setTimeout(function(){t.classList.remove("on")},2200);
}
function showModal(html){
  $("#modalBox").innerHTML=html;
  $("#modalMask").classList.add("on");
}
function closeModal(){$("#modalMask").classList.remove("on")}
$("#modalMask").addEventListener("click",function(e){if(e.target===this)closeModal()});
document.addEventListener("keydown",function(e){if(e.key==="Escape")closeModal()});

function modalHeader(title,extra){
  return '<h3>'+title+'<button class="m-close" onclick="closeModal()">×</button></h3>'+
    (extra?'<div class="hint">'+extra+"</div>":"");
}
function kv(rows){
  return '<dl class="kv">'+rows.map(function(r){
    return "<dt>"+r[0]+"</dt><dd>"+r[1]+"</dd>"}).join("")+"</dl>";
}

/* ============ 路由 ============ */
var ROUTES=["overview","tasks","chat","approval","graph","seminar"];
var RENDER={};
function go(route,param){
  if(ROUTES.indexOf(route)<0)route="overview";
  location.hash=route+(param?"/"+param:"");
}
function renderRoute(){
  var parts=location.hash.replace(/^#/,"").split("/");
  var route=parts[0]||"overview",param=parts[1];
  $all(".page").forEach(function(p){p.classList.remove("active")});
  var pg=$("#page-"+route);
  if(pg)pg.classList.add("active");
  $all("#nav button").forEach(function(b){
    b.classList.toggle("on",b.dataset.route===route)});
  window.scrollTo(0,0);
  if(RENDER[route])RENDER[route](param);
}
window.addEventListener("hashchange",renderRoute);

$all("#nav button").forEach(function(b){
  b.addEventListener("click",function(){go(b.dataset.route)});
});
$all("#nav [data-route],#nav [data-icon]").forEach(function(b){
  b.insertAdjacentHTML("afterbegin",ico(b.dataset.route||b.dataset.icon));
});

