          '</div>'+
        '</div>'+
        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>任务状态构成</h4><span class="hint">今日实时</span></div>'+
          '<div class="donut-wrap">'+
            '<div class="ov-donut"><svg viewBox="0 0 36 36" style="transform:rotate(-90deg)">'+
              '<circle cx="18" cy="18" r="15.915" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="4.4"/>'+
              '<circle cx="18" cy="18" r="15.915" fill="none" stroke="#E63A84" stroke-width="4.4" stroke-dasharray="75.7 100" stroke-dashoffset="0" stroke-linecap="butt"/>'+
              '<circle cx="18" cy="18" r="15.915" fill="none" stroke="#3BE7FF" stroke-width="4.4" stroke-dasharray="13.5 100" stroke-dashoffset="-75.7" stroke-linecap="butt"/>'+
              '<circle cx="18" cy="18" r="15.915" fill="none" stroke="#9B7BFF" stroke-width="4.4" stroke-dasharray="10.8 100" stroke-dashoffset="-89.2" stroke-linecap="butt"/>'+
            '</svg><div class="ctr"><div class="n" id="ovdn">0</div><div class="l">今日任务（单）</div></div></div>'+
            '<div class="dlg">'+
              '<div class="li" data-r="tasks"><i style="background:#E63A84"></i><span class="nm">已完成</span><span class="pct">75.7%</span><span class="v">28</span></div>'+
              '<div class="li" data-r="tasks"><i style="background:#3BE7FF"></i><span class="nm">执行中</span><span class="pct">13.5%</span><span class="v">5</span></div>'+
              '<div class="li" data-r="approval"><i style="background:#9B7BFF"></i><span class="nm">待审批</span><span class="pct">10.8%</span><span class="v">4</span></div>'+
            '</div>'+
          '</div>'+
        '</div>'+
      '</div>'+


      '<div class="ov-row r3">'+
        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>各岗位任务量</h4><span class="hint">深品红=完成 紫=在办</span></div>'+
          '<div class="bars" id="ovbars"></div>'+
        '</div>'+
        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>待办与挂起</h4><span class="hint">'+countTasks("wait")+' 条需老板处理</span></div>'+
          '<div class="ov-lst" id="ovalerts"></div>'+
        '</div>'+
        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>24h 任务与 Token 走势</h4>'+
            '<span class="hint"><i style="background:#3BE7FF;width:8px;height:2px;display:inline-block;border-radius:1px;margin-right:4px"></i>任务<i style="background:#E23A82;width:8px;height:2px;display:inline-block;border-radius:1px;margin:0 4px 0 10px"></i>Token(万)</span></div>'+
          '<div class="ov-trend"><svg viewBox="0 0 320 200" preserveAspectRatio="none" id="ovtrend"></svg></div>'+
          '<div class="xlab"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>现在</span></div>'+
        '</div>'+
      '</div>'+
      '<div class="ov-row r2">'+
        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>知识库动态</h4><span class="hint">最新发布 / 更新</span></div>'+
          '<div class="ov-lst" id="ovknow"></div>'+
        '</div>'+
        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>系统健康与成本</h4><span class="hint">全链路监控</span></div>'+
          '<div class="ov-lst">'+
            healthRow('服务可用性','99.98%','')+healthRow('全链路告警','0 条','')+
            healthRow('今日费用','¥18.42 / 预算 ¥100','cy')+healthRow('Token 余量','81.6%','cy')+
            healthRow('模型平均响应','3.2 秒','')+healthRow('近 7 日发布','9 次','vi')+
          '</div>'+
        '</div>'+
      '</div>'+
    '</div>';

  $all("#ov2 .ov-kpi").forEach(function(k,i){
    k.onclick=function(){go(["chat","tasks","tasks","approval","tasks"][i])};
  });
  $all("#ov2 .dlg .li").forEach(function(li){
    li.onclick=function(){go(li.getAttribute("data-r"))};
  });

  startMib();
  countUp(document.getElementById("ovdn"),37,1700);

  var dify=STAFF.filter(function(x){return x.group==="dify"}).slice().sort(function(a,b){return roleOrder.indexOf(a.id)-roleOrder.indexOf(b.id)});
  var bars=$("#ovbars");
  bars.innerHTML=dify.map(function(x){
    var tot=x.tasksToday,h=(tot/6*100);
    return '<div class="bcol" data-id="'+x.id+'"><span class="bv">'+tot+'</span>'+
      '<div class="bstack" data-h="'+h+'"><div class="a" style="flex:'+(tot-1)+'"></div>'+
      '<div class="b" style="flex:1"></div></div><span class="bl">'+(roleShort[x.id]||x.role)+'</span></div>';
  }).join("");
  requestAnimationFrame(function(){setTimeout(function(){
    $all(".bstack",bars).forEach(function(e){e.style.height=e.getAttribute("data-h")+"%"})},80)});
  $all(".bcol",bars).forEach(function(c){
    c.onclick=function(){var st=staffById(c.getAttribute("data-id"));if(st)staffModal(st)};
  });

  var waits=TASKS.filter(function(t){return t.status==="wait"});
  $("#ovalerts").innerHTML=waits.map(function(t){
    var st=staffById(t.owner);
    var meta=t.cost?("¥"+t.cost.toFixed(2)):t.stage;
    return '<div class="ov-krow" data-r="approval"><span class="ad"></span>'+
      '<span class="tt">'+esc(t.title)+'</span><span class="cost">'+meta+'</span>'+
      '<span class="who">'+st.role.replace('工程师','')+'</span></div>';
  }).join("");
  $all("#ovalerts .ov-krow").forEach(function(r){r.onclick=function(){go("approval")}});

  $("#ovknow").innerHTML=KNOWLEDGE.map(function(k){
    var st=staffById(k.by);
    return '<div class="ov-krow" data-r="graph"><span class="tag '+(k.type==="新增"?"new":"upd")+'">'+k.type+'</span>'+
      '<span class="tt">'+esc(k.title)+'</span><span class="rf">引用 '+k.refs+'</span>'+
      '<span class="tm">'+st.role.replace('工程师','').replace('专员','')+' · '+k.time+'</span></div>';
  }).join("");
  $all("#ovknow .ov-krow").forEach(function(r){r.onclick=function(){go("graph")}});

  drawOvTrend();
};

function kviIco(k){
  var ic={
    online:'<circle cx="12" cy="8" r="3.4"/><path d="M5 19c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>',
    tasks:'<rect x="5" y="4.5" width="14" height="15" rx="2.5"/><path d="M9 9.5h6M9 13h6M9 16.5h4"/>',
    done:'<circle cx="12" cy="12" r="8.5"/><path d="M8.2 12.2l2.6 2.6 4.6-5"/>',
    wait:'<circle cx="12" cy="13" r="8"/><path d="M12 8.5V13l3 2"/><path d="M12 3.2v2.4"/>',
    token:'<path d="M13 2.5L6 12.5h5l-1 9 7-10.5h-5l1-8.5z"/>'
  };
  return '<svg class="kvi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">'+ic[k]+'</svg>';
}
function ovK(label,val,trend,cls){
  return '<div class="ov-kpi '+cls+'"><div class="kl">'+label+'</div>'+
    '<div class="kv">'+val+'</div><div class="kt">'+trend+'</div></div>';
}
function flowNode(cls,dot,role,meta,left,top,badge){
  return '<div class="fn '+cls+'" style="left:'+left+';top:'+top+'"><div class="chip">'+
    '<div class="dot '+dot+'"></div><div class="role">'+role+'</div><div class="meta">'+meta+'</div>'+
    (badge?'<span class="badge">'+badge+'</span>':'')+'</div></div>';
}
function endNode(cls,role,meta,left,top){
  return '<div class="fe '+cls+'" style="left:'+left+';top:'+top+'"><div class="chip">'+
    '<div class="role">'+role+'</div><div class="meta">'+meta+'</div></div></div>';
}
function healthRow(name,val,cls){
  return '<div class="ov-krow"><span class="tt">'+name+'</span><span class="hc '+cls+'">'+val+'</span></div>';
}
function countUp(node,target,dur){
  var t0=performance.now();
  function step(t){
    var p=Math.min(1,(t-t0)/dur);
    node.textContent=Math.round(target*p);
    if(p<1)requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function startFlowParticles(){
  var svg=document.getElementById("ovsvg");
  if(!svg||window.__ovParticles)return;
  window.__ovParticles=true; var conf=[["ovp0","#FF4D97",2200,0],["ovp0","#FF4D97",2200,1100],["ovp0","#FD7EBB",2200,550],["ovp1","#3BE7FF",2000,100],["ovp1","#6FE9FF",2000,1100],["ovp2","#3BE7FF",2000,500],["ovp2","#6FE9FF",2000,1500],["ovp3","#9B7BFF",1500,180],["ovp3","#9B7BFF",1500,900],["ovp4","#9B7BFF",1500,300],["ovp4","#9B7BFF",1500,1050],["ovp5","#9B7BFF",1500,240],["ovp5","#9B7BFF",1500,1000],["ovp6","#9B7BFF",1500,340],["ovp6","#9B7BFF",1500,1100],["ovp7","#FF4D97",1800,260],["ovp7","#FF4D97",1800,1250],["ovp8","#FF4D97",1800,320],["ovp8","#FF4D97",1800,1350]]
  var particles=conf.map(function(c){
    var path=document.getElementById(c[0]);
    var circle=document.createElementNS(SVGNS,"circle");
    circle.setAttribute("r",3.4);circle.setAttribute("fill",c[1]);
    circle.setAttribute("style","filter:drop-shadow(0 0 7px "+c[1]+")");
    svg.appendChild(circle);
    return {path:path,circle:circle,len:path.getTotalLength(),dur:c[2],off:c[3]};
  });
  var start=performance.now();
  function tick(t){
    particles.forEach(function(p){
      var u=((t-p.off)%p.dur)/p.dur;
      var pt=p.path.getPointAtLength(p.len*u);
      p.circle.setAttribute("opacity",u<0.08||u>0.92?0:1);
      p.circle.setAttribute("cx",pt.x);p.circle.setAttribute("cy",pt.y);
    });
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

function startMib(){
  // 任务吞吐迷你折线
  var svg=document.getElementById("mivThp"); var ns="http://www.w3.org/2000/svg";
  if(svg){ svg.setAttribute("width","100%"); svg.setAttribute("height","100%");
    var series=[38,42,36,48,44,52,47,56,50,60,55,63,58,66,61,70];
    var W=120,H=40,pad=2,max=75; var aPath="M0,"+H,ln="";
    series.forEach(function(v,i){ var x=i/(series.length-1)*W, y=H-(v/max)*(H-pad*2)-pad;
      aPath+=" L"+x.toFixed(1)+" "+y.toFixed(1); ln+=(i?"L":"M")+x.toFixed(1)+" "+y.toFixed(1); });
    aPath+=" L"+W+","+H+" Z";
    var a=document.createElementNS(ns,"path"); a.setAttribute("d",aPath); a.setAttribute("fill","rgba(59,231,255,.10)");
    var p=document.createElementNS(ns,"path"); p.setAttribute("d",ln); p.setAttribute("fill","none");
    p.setAttribute("stroke","#3BE7FF"); p.setAttribute("stroke-width",2); p.setAttribute("stroke-linejoin","round"); p.setAttribute("stroke-linecap","round");
    p.style.filter="drop-shadow(0 0 4px rgba(59,231,255,.6))";
    var lv=series[series.length-1],ly=H-(lv/max)*(H-pad*2)-pad;
    var c=document.createElementNS(ns,"circle"); c.setAttribute("cx",W); c.setAttribute("cy",ly); c.setAttribute("r",3); c.setAttribute("fill","#3BE7FF");
    svg.appendChild(a); svg.appendChild(p); svg.appendChild(c);
  }
  // 岗位负载堆叠（6 柱多彩）
  var stack=document.getElementById("mivStack");
  if(stack){ var staff=[["设计",16,"#E63A84"],["文案",14,"#FF4D97"],["开发",22,"#FF7AC6"],["视频",11,"#9B7BFF"],["客服",9,"#3BE7FF"],["实施",7,"#3DDCA0"]];
    staff.forEach(function(s){ var d=document.createElement("div"); d.className="st";
      d.style.background=s[2]; d.title=s[0]+" "+s[1]; d.setAttribute("data-h",(s[1]/22*100).toFixed(1)); stack.appendChild(d); });
    requestAnimationFrame(function(){setTimeout(function(){ Array.prototype.forEach.call(stack.children,function(b){ b.style.height=b.getAttribute("data-h")+"%" }); },160); });
  }
  // 完成率半环 0→75.7%
  var seg=document.querySelectorAll("#miv .mivseg")[0];
  if(seg){ requestAnimationFrame(function(){ setTimeout(function(){ seg.setAttribute("stroke-dasharray","75.7 100"); },160); }); }
  // Token 消耗 12 根粉紫渐变微柱
  var tok=document.getElementById("mivTok");
  if(tok){ var vals=[9,14,11,18,13,22,16,25,19,28,21,24];
    vals.forEach(function(v){ var b=document.createElement("div"); b.className="mb";
      b.style.background="linear-gradient(180deg,#E63A84,#9B7BFF)"; b.setAttribute("data-h",(v/28*100).toFixed(1)); tok.appendChild(b); });
    requestAnimationFrame(function(){setTimeout(function(){ Array.prototype.forEach.call(tok.children,function(b){ b.style.height=b.getAttribute("data-h")+"%" }); },160); });
  }
}
function drawOvTrend(){
  var T=TREND;
  var K=T.map(function(v){return +(v*2.4+1.2).toFixed(1)});
  var W=320,H=200,pad=18,n=T.length;
  function xy(arr,mx){return arr.map(function(v,i){
    return [i*(W-2*pad)/(n-1)+pad,H-pad-(v/mx)*(H-2*pad)]})}
  var pT=xy(T,10),pK=xy(K,24);
  function line(ps){return "M"+ps.map(function(p){return p[0]+" "+p[1]}).join(" L")}
  var dT=line(pT),dK=line(pK);
  var areaK=dK+" L"+pK[n-1][0]+" "+(H-pad)+" L"+pK[0][0]+" "+(H-pad)+" Z";
  var areaT=dT+" L"+pT[n-1][0]+" "+(H-pad)+" L"+pT[0][0]+" "+(H-pad)+" Z";
  var svg=document.getElementById("ovtrend");
  svg.innerHTML=
    '<defs>'+
      '<linearGradient id="ovagK" x1="0" y1="0" x2="0" y2="1">'+
        '<stop offset="0" stop-color="#E23A82" stop-opacity=".35"/><stop offset="1" stop-color="#E23A82" stop-opacity="0"/></linearGradient>'+
      '<linearGradient id="ovagT" x1="0" y1="0" x2="0" y2="1">'+
        '<stop offset="0" stop-color="#3BE7FF" stop-opacity=".4"/><stop offset="1" stop-color="#3BE7FF" stop-opacity="0"/></linearGradient>'+
    '</defs>'+
    [0,1,2,3].map(function(g){
      var y=pad+g*(H-2*pad)/3;
      return '<line x1="0" y1="'+y+'" x2="320" y2="'+y+'" stroke="rgba(133,160,255,.15)" stroke-dasharray="4 5"/>'}).join("")+
    '<path d="'+areaK+'" fill="url(#ovagK)"/>'+
    '<path d="'+areaT+'" fill="url(#ovagT)"/>'+
    '<path class="ovtl" d="'+dK+'" fill="none" stroke="#E23A82" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>'+
    '<path class="ovtl" d="'+dT+'" fill="none" stroke="#3BE7FF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>'+
    pT.map(function(p){return '<circle cx="'+p[0]+'" cy="'+p[1]+'" r="3" fill="#0a0f20" stroke="#3BE7FF" stroke-width="1.6"/>'}).join("")+
    pK.map(function(p){return '<circle cx="'+p[0]+'" cy="'+p[1]+'" r="2.6" fill="#0a0f20" stroke="#E23A82" stroke-width="1.4"/>'}).join("");
  var t0=performance.now();
  function reveal(t){
    var p=Math.min(1,(t-t0)/1800),ease=1-Math.pow(1-p,3);
    $all(".ovtl",svg).forEach(function(path){
      var L=path.getTotalLength();
      path.setAttribute("stroke-dasharray",L);
      path.setAttribute("stroke-dashoffset",L*(1-ease));
    });
    if(p<1)requestAnimationFrame(reveal);
  }
  requestAnimationFrame(reveal);
}

var TASK_FILTERS=[["all","全部"],["busy","执行中"],["wait","待审批"],["done","已完成"]];
RENDER.tasks=function(param){
  var pg=$("#page-tasks");
  pg.innerHTML='<div class="phead"><h2><span class="barline"></span>任务中心</h2>'+
    '<div class="crumb">共 <b>'+TASKS.length+'</b> 单 · 点击行查看任务详情</div></div>'+
    '<div class="table-tools" id="taskTools">'+
    TASK_FILTERS.map(function(f){return '<button class="filter-btn" data-f="'+f[0]+'">'+f[1]+"</button>"}).join("")+
    '<span style="margin-left:auto;font-size:11.5px;color:var(--txt-3);align-self:center">数据来自 relay · 只读展示，处置回原系统</span></div>'+
    '<div class="panel table-scroll" style="padding:6px 12px"><table><thead><tr>'+
    "<th>任务号</th><th>任务</th><th>负责员工</th><th>状态/阶段</th><th>费用</th><th>时间</th>"+
    "</tr></thead><tbody></tbody></table></div>";
  var tbody=pg.querySelector("tbody");
  function rows(filter){
    tbody.innerHTML="";
    TASKS.filter(function(t){return filter==="all"||t.status===filter}).forEach(function(t){
      var s=staffById(t.owner);
      var tr=document.createElement("tr");
      tr.innerHTML="<td><span class='t-id'>#"+t.id+"</span></td>"+
        "<td><div>"+esc(t.title)+"</div><div class='cell-sub'>"+esc(t.brief)+"</div></td>"+
        "<td><div style='display:flex;align-items:center;gap:7px'><span class='s-ava' style='width:26px;height:26px;border-radius:8px'>"+realAvatar(s)+"</span>"+s.name+"</div></td>"+
        "<td>"+statusPill(t.status)+"<div class='cell-sub'>"+t.stage+"</div></td>"+
        "<td>"+(t.cost?"¥"+t.cost.toFixed(2):'<span class="cell-sub">—</span>')+"</td>"+
        "<td class='cell-sub'>"+t.time+"</td>";
      tr.onclick=function(){taskModal(t)};
      tbody.appendChild(tr);
    });
  }
  var initFilter="all";
  if(param){
    var map={busy:"busy",wait:"wait",done:"done",queue:"busy"};
    initFilter=map[param]||"all";
  }
  rows(initFilter);
  $all(".filter-btn",pg).forEach(function(b){
    if(b.dataset.f===initFilter){b.classList.add("on")}
    b.onclick=function(){
      $all(".filter-btn",pg).forEach(function(x){x.classList.remove("on")});
      b.classList.add("on");rows(b.dataset.f);
    };
  });
};

function taskModal(t){
  var s=staffById(t.owner);
  showModal(modalHeader(t.title,"任务号 #"+t.id)+kv([
    ["任务号",'<span class="mono">#'+t.id+"</span>"],
    ["负责员工",s.full],["状态",statusPill(t.status)],
    ["当前阶段",t.stage],["创建时间","今日 "+t.time],
    ["费用",t.cost?"¥"+t.cost.toFixed(2):"无（不触发付费）"]
  ])+
    '<div style="margin-top:16px"><div class="hint" style="margin-bottom:5px">任务需求</div>'+
    '<div style="font-size:13px;background:rgba(255,255,255,.035);border:1px solid var(--line);border-radius:10px;padding:11px 14px">'+esc(t.brief)+"</div></div>"+
    '<div style="margin-top:14px"><div class="hint" style="margin-bottom:5px">最新进展 / 交付</div>'+
    '<div style="font-size:13px;background:rgba(255,255,255,.035);border:1px solid var(--line);border-radius:10px;padding:11px 14px">'+esc(t.result)+"</div></div>"+
    '<div style="display:flex;gap:9px;margin-top:18px"><button class="btn-view" style="flex:1;padding:9px;border-radius:10px;border:1px solid var(--line);cursor:pointer" onclick="closeModal()">关闭</button>'+
    (t.status==="wait"?'<button class="btn-back" style="flex:1;padding:9px;border-radius:10px;cursor:pointer" onclick="demoAction(\'打回\')">打回</button><button class="btn-pass" style="flex:1;padding:9px;border-radius:10px;cursor:pointer" onclick="demoAction(\'批准\')">批准</button>':
      '<button class="btn-pass" style="flex:1;padding:9px;border-radius:10px;cursor:pointer" onclick="go(\'chat\')">去对话追问</button>')+
    "</div>");
}
function demoAction(a){closeModal();toast("演示版：已模拟「"+a+"」；正式版该处置回原系统执行")}

/* ============ 员工对话页 ============ */
var CHAT_SEED={
  xiaomo:[
    {who:"assistant",text:"老板好，我是小墨。说出需求，我来拆解并派给最合适的岗位；涉及付费的任务会先挂起等您审批。"},
    {who:"me",text:"帮我给「拆解工具包」做一版抖音投放落地页，先出文案再出主视觉，明天中午前要。"},
    {who:"assistant",text:"已拆解并派单：\n① 文案专家-如花：落地页文案（进行中）\n② 图片设计师-秋香：主视觉（待审批图片生成额度 ¥0.84）\n预计 21:40 前交付文案，审批通过后 40 分钟出图。"}
  ],
  ruhua:[
    {who:"assistant",text:"老板，我是如花。落地页文案我先给您 3 个角度：痛点型、案例型、数据型，您选一个我再深化。"}
  ],
  huaan:[
    {who:"assistant",text:"老板好，我是华安。前端切图进行中，首页区块完成 60%，要先看一版效果吗？"}
  ]
};
var CHAT_STATE={};
RENDER.chat=function(param){
  var pg=$("#page-chat");
  pg.innerHTML='<div class="phead"><h2><span class="barline"></span>员工对话</h2>'+
    '<div class="crumb">任务中心对话界面保留 · <b>微信式多行输入</b></div></div>'+
    '<div class="chat-layout"><div class="chat-list" id="chatList"></div>'+
    '<div class="chat-main"><div class="chat-top" id="chatTop"></div>'+
    '<div class="chat-body" id="chatBody"></div>'+
    '<div class="chat-input" id="chatInputBox"></div></div></div>';
  var list=$("#chatList");
  var dv=el("div","cl-group");dv.textContent="Dify 内 · 10 名员工（可对话派单）";list.appendChild(dv);
  STAFF.filter(function(s){return s.group==="dify"}).forEach(function(s){
    var item=el("div","cl-item");
    item.dataset.id=s.id;
    var state=CHAT_STATE[s.id]||CHAT_SEED[s.id];
    var last=state?state[state.length-1].text:defaultGreeting(s);
    item.innerHTML='<span class="cl-ava">'+realAvatar(s)+statusDot(s)+"</span>"+
      '<div><div class="cl-name">'+s.name+"</div><div class='cl-last'>"+esc(last.slice(0,16))+"</div></div>"+
      (s.id==="xiaomo"?'<span class="cl-badge">2</span>':"");
    item.onclick=function(){openChat(s.id)};
    list.appendChild(item);
  });
  var note=el("div","cl-note");
  note.textContent="外部协同 4 位（砚舟/旺财/初墨/9527）按隔离边界不在此对话，其状态请到总览查看。";
  list.appendChild(note);
  openChat(param||"xiaomo");
};

function openChat(id){
  var s=staffById(id);
  if(!CHAT_STATE[id]){
    var seed=CHAT_SEED[id];
    CHAT_STATE[id]=seed
      ? seed.map(function(m){return {who:m.who,text:m.text}})
      : [{who:"assistant",text:defaultGreeting(s)}];
  }
  $all("#chatList .cl-item").forEach(function(i){i.classList.toggle("on",i.dataset.id===id)});
  $("#chatTop").innerHTML='<span class="s-ava" style="width:38px;height:38px;border-radius:11px">'+realAvatar(s)+"</span>"+
    '<div><div class="ct-name">'+s.full+"</div><div class='ct-sub'>"+(s.status==="wait"?"挂起待审":s.stat)+" · "+s.sub+"</div></div>"+
    '<button class="demo-btn" id="longDemo" style="margin-left:auto">📝 填入长段需求</button>';
  var body=$("#chatBody");
  body.innerHTML="";
  CHAT_STATE[id].forEach(function(m){appendMsg(body,s,m)});
  body.scrollTop=body.scrollHeight;

  $("#chatInputBox").innerHTML='<div class="input-wrap"><textarea class="ta" rows="1" placeholder="给'+s.name+'派个任务…（Enter 发送，Shift+Enter 换行）"></textarea>'+
    '<div class="input-bar"><span class="ib-ico">😊</span><span class="ib-ico">📎</span><span class="ib-ico">🖼️</span><span class="ib-ico">🎤</span>'+
    '<span class="char-count">0 字</span><button class="send-btn" disabled>发送</button></div></div>'+
    '<div class="input-feat" style="display:flex;gap:14px;margin-top:9px;font-size:11px;color:var(--txt-3);flex-wrap:wrap">'+
    "<span style='color:var(--green)'>✓ 多行自动撑开</span><span style='color:var(--green)'>✓ 所见即所得</span><span style='color:var(--green)'>✓ 长文不截断可回看</span></div>";

  var ta=$("#chatInputBox .ta"),cc=$("#chatInputBox .char-count"),
      btn=$("#chatInputBox .send-btn");
  function autosize(){
    ta.style.height="auto";
    ta.style.height=Math.min(ta.scrollHeight,150)+"px";
    cc.textContent=ta.value.length+" 字";
    btn.disabled=!ta.value.trim();
  }
  ta.oninput=autosize;
  ta.onkeydown=function(e){if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();doSend()}};
  function doSend(){
    var v=ta.value.trim();if(!v)return;
    CHAT_STATE[id].push({who:"me",text:v});
    appendMsg(body,s,{who:"me",text:v});
    ta.value="";autosize();body.scrollTop=body.scrollHeight;
    var typing=el("div","msg");
    typing.innerHTML='<span class="m-ava">'+realAvatar(s)+"</span>"+
      '<div class="m-bubble typing"><span></span><span></span><span></span></div>';
    body.appendChild(typing);body.scrollTop=body.scrollHeight;
    setTimeout(function(){
      typing.remove();
      var reply={who:"assistant",text:"收到，需求已完整记录（共 "+v.length+" 字，换行与格式都保留了），正在拆解并匹配岗位，稍等给您方案。"};
      CHAT_STATE[id].push(reply);
      appendMsg(body,s,reply);
      body.scrollTop=body.scrollHeight;
    },1400);
  }
  btn.onclick=doSend;

  $("#longDemo").onclick=function(){
    ta.value=LONG_BRIEF;autosize();ta.scrollTop=0;ta.focus();
  };
}

function appendMsg(body,s,m){
  var d=el("div","msg "+(m.who==="me"?"me":""));
  d.innerHTML=(m.who==="me"?'<span class="m-ava" style="background:linear-gradient(135deg,'+s.grad+')">老</span>':'<span class="m-ava">'+realAvatar(s)+"</span>")+
    '<div class="m-bubble"></div>';
  d.querySelector(".m-bubble").textContent=m.text;
  body.appendChild(d);
}

function defaultGreeting(s){
  if(s.group==="ext")return "老板好，我是"+s.name+"（外部协同岗）。这里可以查看我的工作进展；涉及执行的事项请回到对应系统发起。";
  return "老板好，我是"+s.name+"，负责"+s.role+"。直接告诉我需求，我来干活；要派单也可以找小墨统一安排。";
}

var LONG_BRIEF=
"老板，我想给「拆解工具包」做一次完整的抖音冷启动投放，需求如下：\n"+
"1. 目标用户：35-50 岁中小实体老板，不懂技术，痛点是获客贵、不会做内容；\n"+
"2. 内容方向：每周 3 条口播 + 2 条图文，先连发两周测试点击率，重点测开头 3 秒钩子；\n"+
"3. 需要产出：① 10 条口播文案（每条 200 字内，口语化、有金句）；② 5 张封面主视觉（大字标题、统一配色）；③ 一版 15 秒宣传片脚本；\n"+
"4. 时间：本周五前先交 5 条文案和 2 张封面，确认风格后再批量做；\n"+
"5. 预算：图片与视频费用控制在 50 元内，超了先停下问我；\n"+
"6. 其他：不出现夸大承诺和医疗、投资类敏感词，交付物统一归档并建索引。\n"+
"辛苦帮我拆一下、派下去，拿不准随时回来问我。";

/* ============ 审批中心页 ============ */
RENDER.approval=function(){
  var pg=$("#page-approval");
  var waits=TASKS.filter(function(t){return t.status==="wait"});
  pg.innerHTML='<div class="phead"><h2><span class="barline"></span>审批中心</h2>'+
    '<div class="crumb"><b>'+waits.length+'</b> 条待审批 · 只读聚合，处置回原系统</div></div>'+
    '<div class="appr-grid" id="apprGrid"></div>';
  var grid=$("#apprGrid");
  waits.forEach(function(t){
    var s=staffById(t.owner);
    var a=el("div","appr");
    a.innerHTML='<div class="a-top"><span class="a-id">#'+t.id+"</span><span>"+t.stage+"</span></div>"+
      "<h5>"+esc(t.title)+"</h5><p>"+esc(t.brief)+"</p>"+
      '<div class="a-meta"><span>负责：'+s.name+"</span>"+(t.cost?'<span>费用 <b>¥'+t.cost.toFixed(2)+"</b></span>":"<span>不触发付费</span>")+
      "<span>今日 "+t.time+"</span></div>"+
      '<div class="a-btns"><button class="btn-view">详情</button><button class="btn-back">打回</button><button class="btn-pass">批准</button></div>';
    var btns=a.querySelectorAll("button");
    btns[0].onclick=function(){taskModal(t)};
    btns[1].onclick=function(){a.style.opacity=".45";toast("演示：已模拟打回 #"+t.id)};
    btns[2].onclick=function(){
      a.style.transition=".4s";a.style.opacity="0";a.style.transform="scale(.95)";
      setTimeout(function(){a.style.display="none"},400);
      toast("演示：已模拟批准 #"+t.id+"（正式版回原系统生效）");
    };
    grid.appendChild(a);
  });
};

/* ============ 知识图谱页（v0.7 同款 3D 知识银河） ============ */
RENDER.graph=function(){
  var pg=$("#page-graph");
  pg.innerHTML='<div class="phead"><h2><span class="barline"></span>知识图谱 · 知识银河</h2>'+
    '<div class="crumb">3D 星空网络 · 拖拽/平移 · 悬停聚焦 · 点星看详情</div></div>'+
    '<div class="galaxy-shell"><div id="galaxyMount"></div></div>';
  var ok=window.__startGalaxy ? window.__startGalaxy() : (window.__startGraphForce && window.__startGraphForce());
  setTimeout(function(){
    if(window.__galaxyResize)window.__galaxyResize();
  },60);
  if(!ok)console.warn("银河初始化未就绪");
};
function knowledgeNodeModal(n){
  var items=KNOWLEDGE.filter(function(k){return true}).slice(0,4);
  showModal(modalHeader("📚 "+n.label+" 知识节点","该节点下最新知识条目"));
  var box=$("#modalBox");
  var html='<div style="margin-top:14px;display:flex;flex-direction:column;gap:9px">'+
    items.map(function(k,i){
      return '<div style="display:flex;gap:10px;align-items:center;font-size:13px"><span style="color:var(--txt-3);font-size:11px;width:44px">'+k.time+"</span>"+
        '<span>'+esc(k.title)+'</span><span style="margin-left:auto;font-size:11px;color:var(--violet)">引用 '+k.refs+"</span></div>";
    }).join("")+"</div>"+
    '<button class="btn-pass" style="width:100%;margin-top:18px;padding:10px;border-radius:10px;cursor:pointer" onclick="closeModal()">知道了</button>';
  box.insertAdjacentHTML("beforeend",html);
}

/* ============ 研讨室页 ============ */
var SEMINAR=[
  {who:"xiaoming",text:"关于拆解工具包 V2，我建议主打「30 秒看懂风险」，把最有冲击力的结果前置；收费点放在深度拆解和导出。"},
  {who:"ruhua",text:"文案上开头钩子准备了三个版本：数字冲击型、身份代入型、反常识型，可以各做一条口播测点击率。"},
  {who:"bohu",text:"竞品这边 5 家里 3 家按次收费、2 家做会员；差异化可以打「按次低价试用 + 不注册也能看结果」。"},
  {who:"huaan",text:"技术无压力：H5 单页即可承载，图表前端原生渲染；移动端输入框自动撑开，避免长需求被截断。"},
  {who:"xiaoming",text:"综合意见，下一步：① 如花出 3 条口播；② 伯虎补竞品价格表；③ 华安做可点击原型。老板确认后排期。"}
];
RENDER.seminar=function(){
  var pg=$("#page-seminar");
  pg.innerHTML='<div class="phead"><h2><span class="barline"></span>项目研讨室</h2>'+
    '<div class="crumb">多员工协同研讨 · 只读回放</div></div>'+
    '<div class="seminar-layout"><div class="seminar-stage" id="semStage"></div>'+
    '<div class="sem-side" id="semSide"></div></div>';
  var stage=$("#semStage");
  SEMINAR.forEach(function(m){
    var s=staffById(m.who);
    var w=el("div","sem-speaker");
    w.innerHTML='<span class="sem-ava">'+realAvatar(s)+"</span>"+
      '<div class="sem-card"><div class="sem-who">'+s.full+"</div>"+esc(m.text)+"</div>";
    stage.appendChild(w);
  });
  var side=$("#semSide");
  side.innerHTML="<h4>参会成员</h4>";
  ["xiaoming","ruhua","bohu","huaan"].forEach(function(id){
    var s=staffById(id);
    var p=el("div","participant");
    p.innerHTML='<span class="s-ava" style="width:26px;height:26px;border-radius:8px">'+realAvatar(s)+"</span>"+
      s.name+'<i style="background:var(--green)"></i>';
    p.onclick=function(){staffModal(s)};
    side.appendChild(p);
  });
  side.insertAdjacentHTML("beforeend",
    '<button class="btn-pass" style="width:100%;margin-top:18px;padding:10px;border-radius:10px;cursor:pointer" id="genMinute">生成研讨纪要</button>');
  $("#genMinute").onclick=function(){toast("演示：已生成研讨纪要并回传任务中心")};
};

renderRoute();


