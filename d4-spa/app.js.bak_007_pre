              '<div class="mc-ring"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15.915" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="3.6"/><circle class="mivseg" cx="18" cy="18" r="15.915" fill="none" stroke="#3DDCA0" stroke-width="3.6" stroke-linecap="round" stroke-dasharray="0 100" transform="rotate(-90 18 18)"/></svg></div>'+
              '<div class="mc-f"><i style="background:#3DDCA0"></i>平均交付 14分32秒</div></div>'+
            '<div class="mc"><div class="mc-t">Token 消耗</div><div class="mc-v">52.6<small>万</small></div>'+
              '<div class="mc-bars" id="mivTok"><title>Token 消耗趋势</title></div>'+
