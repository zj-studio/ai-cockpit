        '<div class="ov-panel">'+
          '<div class="ov-ph"><h4>经营多指标实时带</h4><span class="hint">吞吐 · 负载 · 完成 · 成本</span></div>'+
          '<div class="miv" id="miv">'+
            '<div class="mc"><div class="mc-t">任务吞吐</div><div class="mc-v">37<small>单/时</small></div>'+
              '<div class="mc-chart"><svg viewBox="0 0 120 40" preserveAspectRatio="none" id="mivThp"><title>任务吞吐趋势</title></svg></div>'+
              '<div class="mc-f"><i style="background:#3BE7FF"></i><b class="up">▲ 12.4%</b> 较前一时段</div></div>'+
