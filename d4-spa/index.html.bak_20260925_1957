<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta http-equiv="Cache-Control" content="no-store,no-cache,must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 运营监管与协同自治中枢 · v0.8.0</title>
<style>
:root{
  --bg:#070A14;--bg-2:#0B1020;
  --panel:rgba(20,28,52,.72);--panel-2:rgba(15,22,42,.85);
  --line:rgba(120,150,220,.14);--line-strong:rgba(120,160,255,.30);
  --txt:#EAF0FF;--txt-2:#9AA7C7;--txt-3:#5E6B8D;
  --cyan:#38E1FF;--blue:#4D7CFE;--violet:#8B7BFF;
  --green:#3DDCA0;--amber:#FFC24D;--red:#FF6B7A;--pink:#FF7AC6;
  --shadow:0 18px 50px rgba(0,0,0,.45);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:"PingFang SC","Microsoft YaHei","Segoe UI",system-ui,-apple-system,sans-serif;
  background:var(--bg);color:var(--txt);
  background-image:
    radial-gradient(900px 500px at 12% -8%,rgba(77,124,254,.16),transparent 60%),
    radial-gradient(800px 480px at 92% -4%,rgba(56,225,255,.10),transparent 55%),
    radial-gradient(700px 600px at 50% 118%,rgba(139,123,255,.10),transparent 60%);
  background-attachment:fixed;line-height:1.6;min-height:100vh;
}
a{color:inherit}
button{font-family:inherit}
.app{max-width:1400px;margin:0 auto;padding:0 26px 70px}
.top{display:flex;align-items:center;gap:22px;padding:0 26px;height:64px;position:sticky;top:0;z-index:50;
  background:linear-gradient(180deg,rgba(14,20,40,.97),rgba(9,14,30,.92));
  border-bottom:1px solid var(--line);backdrop-filter:blur(14px)}
.logo{display:flex;align-items:center;gap:11px;font-weight:700;font-size:15px;letter-spacing:.5px;white-space:nowrap}
.logo-mark{width:38px;height:38px;border-radius:11px;flex:none;display:grid;place-items:center;position:relative;
  background:linear-gradient(135deg,#FF4D97,#9B7BFF);
  box-shadow:0 6px 20px rgba(255,77,151,.45),inset 0 0 10px rgba(255,255,255,.18)}

.logo-mark span{font-family:Arial,Helvetica,sans-serif;font-weight:800;font-size:18px;line-height:1;font-style:italic;
  background:linear-gradient(135deg,#FFFFFF 12%,#B39DFF 52%,#69E7FF 100%);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.logo .lname{font-size:15px;font-weight:800;line-height:1.25}
.logo small{display:block;font-size:10.5px;font-weight:500;color:var(--txt-3);letter-spacing:.6px;margin-top:1px}
.logo .ver{font-size:10.5px;color:var(--txt-3);font-weight:500}
.nav{display:flex;gap:2px;margin-left:8px;overflow-x:auto}
.nav button,.nav a{font-size:13px;color:var(--txt-2);background:none;border:0;padding:8px 11px;border-radius:9px;
  cursor:pointer;transition:.2s;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;text-decoration:none}
.nav button:hover,.nav a:hover{color:var(--txt);background:rgba(255,255,255,.05)}
.nav button.on{color:var(--cyan);background:rgba(56,225,255,.10)}
.top-right{margin-left:auto;display:flex;align-items:center;gap:16px;font-size:12px;color:var(--txt-2);white-space:nowrap}
.clock{font-variant-numeric:tabular-nums;color:var(--txt)}
.page{display:none;animation:fade .35s ease;padding-top:24px}
.page.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.phead{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px}
.phead h2{font-size:25px;font-weight:800;display:flex;align-items:center;gap:11px}
.phead h2 .barline{width:4px;height:22px;border-radius:2px;background:linear-gradient(var(--cyan),var(--blue))}
.phead .crumb{font-size:12px;color:var(--txt-3)}
.phead .crumb b{color:var(--cyan)}

.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:17px 18px;
  position:relative;overflow:hidden;transition:.25s;cursor:pointer}
.kpi:hover{border-color:var(--line-strong);transform:translateY(-3px)}
.kpi .k-label{font-size:12px;color:var(--txt-3)}
.kpi .k-val{font-size:29px;font-weight:800;margin-top:7px;font-variant-numeric:tabular-nums}
.kpi .k-val small{font-size:13px;font-weight:600;color:var(--txt-3);margin-left:3px}
.kpi .k-trend{font-size:11.5px;margin-top:5px}
.up{color:var(--green)}.down{color:var(--red)}
.kpi .spark{position:absolute;right:10px;bottom:8px;opacity:.55}
.grid-3{display:grid;grid-template-columns:1.05fr 1.25fr 1fr;gap:14px;margin-top:14px}
.grid-2{display:grid;grid-template-columns:1.55fr 1fr;gap:14px;margin-top:14px}
.panel{background:var(--panel-2);border:1px solid var(--line);border-radius:14px;padding:16px 18px;position:relative}
.panel.clickable{cursor:pointer;transition:.25s}
.panel.clickable:hover{border-color:var(--line-strong);transform:translateY(-3px)}
.panel h4{font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:4px}
.panel h4 .barline{width:3px;height:13px;border-radius:2px;background:linear-gradient(var(--cyan),var(--blue))}
.panel .hint{font-size:11px;color:var(--txt-3)}
.panel-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;gap:10px}
.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--txt-2)}
.legend i{display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:5px}
.more{font-size:11px;color:var(--cyan);background:none;border:0;cursor:pointer}
.donut-box{display:flex;align-items:center;gap:14px;margin-top:6px}
.donut{width:168px;height:168px;flex:none;position:relative}
.donut-box{min-width:0;gap:6px;align-items:center}
.donut{flex:none;width:min(128px,46%);aspect-ratio:1;height:auto}
.donut svg{width:100%;height:100%;transform:rotate(-90deg);overflow:visible}
.donut circle.seg{transition:.25s;cursor:pointer}
.donut circle.seg:hover{filter:brightness(1.25);stroke-width:30}
.donut circle.seg.dim{opacity:.25}
.donut-center{position:absolute;inset:0;display:grid;place-items:center;text-align:center;pointer-events:none}
.donut-center b{font-size:25px;font-weight:800}
.donut-center span{font-size:11px;color:var(--txt-3);display:block}
.donut-legend{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px}
.dl-item{display:flex;align-items:center;gap:9px;font-size:12.5px;cursor:pointer;padding:5px 8px;
  border-radius:8px;margin:-5px -8px;transition:.2s}
.dl-item:hover{background:rgba(255,255,255,.05)}
.dl-item i{width:9px;height:9px;border-radius:3px;flex:none}
.dl-item .n{margin-left:auto;font-weight:700;font-variant-numeric:tabular-nums}
.dl-item .p{color:var(--txt-3);font-size:11px;width:40px;text-align:right}
.bars{display:flex;align-items:flex-end;gap:3px;padding:14px 2px 0;
  border-bottom:1px dashed var(--line)}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:7px;height:100%;justify-content:flex-end;cursor:pointer}
.bar-stack{width:100%;max-width:24px;display:flex;flex-direction:column;
  border-radius:7px 7px 0 0;gap:2px;transition:.4s}
.bar-col:hover .bar-stack{filter:brightness(1.25)}
.bar-col .bv{font-size:11px;font-weight:700;opacity:0;transition:.25s}
.bar-col:hover .bv{opacity:1}
.bar-col .bl{font-size:10px;color:var(--txt-3);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
.bar-a{background:linear-gradient(180deg,#FF7AB0,#E14D93);border-radius:6px 6px 0 0}
.bar-b{background:linear-gradient(180deg,rgba(185,139,255,.85),rgba(185,139,255,.32))}
.trend svg{width:100%;height:212px;overflow:visible}
.trend-line{fill:none;stroke:var(--cyan);stroke-width:2.5;stroke-linecap:round}
.trend-dot{fill:var(--cyan);stroke:#070A14;stroke-width:2;cursor:pointer}
.trend-tip{position:absolute;pointer-events:none;background:#0D1530;border:1px solid var(--line-strong);
  border-radius:8px;padding:6px 10px;font-size:11.5px;opacity:0;transition:.15s;z-index:5;white-space:nowrap}
.x-labels{display:flex;justify-content:space-between;font-size:10.5px;color:var(--txt-3);padding:2px 4px}

.flow-stage{position:relative;height:248px;margin-top:8px}
.flow-stage svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.f-path{fill:none;stroke:url(#flowGrad);stroke-width:2;stroke-dasharray:7 9;animation:dash 1.1s linear infinite}
@keyframes dash{to{stroke-dashoffset:-16}}
.mover{fill:#BFFCFF;filter:drop-shadow(0 0 6px #38E1FF)}
.f-node{position:absolute;transform:translate(-50%,-50%);text-align:center;z-index:2}
.f-node .f-chip{background:linear-gradient(180deg,#141D3A,#0E1530);border:1px solid var(--line-strong);
  border-radius:12px;padding:9px 12px;min-width:104px;transition:.25s;cursor:pointer}
.f-node:hover .f-chip{border-color:var(--cyan);box-shadow:0 0 22px rgba(56,225,255,.25);transform:translateY(-3px)}
.f-node .f-name{font-size:12.5px;font-weight:700}
.f-node .f-sub{font-size:10.5px;color:var(--txt-3);margin-top:1px}
.f-node.hub .f-chip{border-color:rgba(56,225,255,.55);background:linear-gradient(180deg,#122444,#0C1836)}
.f-node .ring{width:8px;height:8px;border-radius:50%;background:var(--green);margin:0 auto 5px;animation:pulse 2s infinite}
.f-node.busy .ring{background:var(--cyan)}
.f-node.warn .ring{background:var(--amber)}
.f-node.pm .f-chip{border-color:rgba(185,139,255,.6);background:linear-gradient(180deg,#1B1740,#120F2E)}
.f-node.pm .ring{background:var(--violet)}
.lane-tag{position:absolute;top:6px;transform:translateX(-50%);font-size:10px;letter-spacing:1px;
  color:var(--txt-3);background:rgba(7,10,20,.7);border:1px solid var(--line);border-radius:8px;padding:1px 9px;z-index:3;white-space:nowrap}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(61,220,160,.6)}70%{box-shadow:0 0 0 8px rgba(61,220,160,0)}100%{box-shadow:0 0 0 0 rgba(61,220,160,0)}}
.staff{display:grid;grid-template-columns:repeat(7,1fr);gap:10px}
.staff-card{background:rgba(13,19,38,.8);border:1px solid var(--line);border-radius:12px;padding:11px 10px;
  text-align:center;cursor:pointer;transition:.25s;position:relative}
.staff-card:hover{transform:translateY(-4px);border-color:var(--line-strong);box-shadow:0 10px 26px rgba(0,0,0,.4)}
.staff-card.dim{opacity:.25}
.s-ava{width:40px;height:40px;border-radius:12px;margin:0 auto 7px;display:grid;place-items:center;
  font-size:15px;font-weight:700;color:#fff}
.s-name{font-size:12.5px;font-weight:700}
.s-role{font-size:10.5px;color:var(--txt-3);margin-top:1px}
.s-stat{display:inline-flex;align-items:center;gap:4px;font-size:10.5px;margin-top:7px;
  padding:2px 9px;border-radius:999px;background:rgba(255,255,255,.04);color:var(--txt-2)}
.s-stat i{width:5px;height:5px;border-radius:50%}
.st-busy i{background:var(--cyan)}.st-idle i{background:var(--green)}
.st-wait i{background:var(--amber)}.st-stop i{background:var(--red)}
.group-divider{grid-column:1/-1;font-size:11px;color:var(--txt-3);letter-spacing:2px;margin:6px 0 -2px;
  display:flex;align-items:center;gap:12px}
.group-divider::after{content:"";flex:1;height:1px;background:var(--line)}
.chat-layout{display:grid;grid-template-columns:240px 1fr;gap:14px;height:640px}
.chat-list{background:rgba(14,20,42,.30);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:14px;padding:10px;overflow-y:auto}
.cl-item{display:flex;gap:9px;align-items:center;padding:9px;border-radius:11px;cursor:pointer;transition:.2s}
.cl-item:hover{background:rgba(255,255,255,.05)}
.cl-item.on{background:rgba(56,225,255,.10)}
.cl-ava{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-weight:700;font-size:13px;color:#fff;flex:none}
.cl-name{font-size:13px;font-weight:700}
.cl-last{font-size:11px;color:var(--txt-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px}
.cl-badge{margin-left:auto;background:var(--red);color:#fff;font-size:10px;border-radius:999px;padding:1px 6px}
.cl-group{font-size:10.5px;color:var(--txt-3);letter-spacing:1.5px;padding:11px 9px 5px}
.cl-note{font-size:10.5px;color:var(--txt-3);line-height:1.6;padding:11px 9px 4px}
.chat-main{background:rgba(14,20,42,.28);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:14px;display:flex;flex-direction:column;min-width:0}
.chat-top{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
.chat-top .ct-name{font-size:14px;font-weight:700}
.chat-top .ct-sub{font-size:11px;color:var(--txt-3)}
.chat-body{flex:1;overflow-y:auto;padding:16px 18px;display:flex;flex-direction:column;gap:14px}
.chat-body::-webkit-scrollbar{width:6px}
.chat-body::-webkit-scrollbar-thumb{background:rgba(120,150,220,.25);border-radius:3px}
.msg{display:flex;gap:10px;max-width:80%}
.msg .m-ava{width:34px;height:34px;border-radius:11px;flex:none;display:grid;place-items:center;
  font-size:12px;font-weight:700;color:#fff}
.m-bubble{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:4px 13px 13px 13px;
  padding:10px 14px;font-size:13px}
.m-name{font-size:11px;color:var(--txt-3);margin-bottom:3px}
.msg.me{align-self:flex-end;flex-direction:row-reverse}
.msg.me .m-bubble{background:linear-gradient(135deg,rgba(77,124,254,.28),rgba(56,225,255,.18));
  border-color:rgba(56,225,255,.3);border-radius:13px 4px 13px 13px;white-space:pre-wrap;word-break:break-word}
.typing span{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--txt-3);
  margin-right:4px;animation:tp 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}
@keyframes tp{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-4px);opacity:1}}
.chat-input{border-top:1px solid var(--line);padding:12px 16px}
.input-wrap{background:rgba(255,255,255,.045);border:1px solid var(--line);border-radius:14px;padding:10px 14px;transition:.2s}
.input-wrap:focus-within{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(56,225,255,.10)}
.ta{width:100%;background:transparent;border:0;outline:0;resize:none;color:var(--txt);
  font-family:inherit;font-size:13.5px;line-height:1.6;max-height:150px;overflow-y:auto}
.ta::placeholder{color:var(--txt-3)}
.input-bar{display:flex;align-items:center;gap:5px;margin-top:8px}
.ib-ico{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-size:15px;
  color:var(--txt-3);cursor:pointer}
.ib-ico:hover{background:rgba(255,255,255,.06);color:var(--txt)}
.char-count{margin-left:auto;font-size:11px;color:var(--txt-3)}
.send-btn{background:linear-gradient(135deg,var(--cyan),var(--blue));border:0;color:#04101f;font-weight:700;
  font-size:13px;padding:7px 20px;border-radius:9px;cursor:pointer}
.send-btn:disabled{opacity:.4;cursor:not-allowed}
.demo-btn{font-size:11px;color:var(--amber);background:rgba(255,194,77,.08);border:1px solid rgba(255,194,77,.3);
  border-radius:8px;padding:5px 11px;cursor:pointer}

.table-tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.filter-btn{font-size:12px;color:var(--txt-2);background:rgba(255,255,255,.04);border:1px solid var(--line);
  border-radius:9px;padding:6px 14px;cursor:pointer;transition:.2s}
.filter-btn:hover{color:var(--txt)}
.filter-btn.on{color:var(--cyan);border-color:var(--line-strong);background:rgba(56,225,255,.08)}
table{width:100%;border-collapse:collapse;font-size:12.5px}

/* ===== D4-002 头像 img 撑满容器 ===== */
.s-ava .ava-img,.m-ava .ava-img,.cl-ava .ava-img,.sem-ava .ava-img{width:100%;height:100%;object-fit:cover;border-radius:11px;display:block}
.s-ava.ava-wrap,.m-ava.ava-wrap,.cl-ava.ava-wrap,.sem-ava.ava-wrap{padding:0;overflow:hidden}
/* ===== D4-002 任务中心表纵向对齐（统一列宽基线） ===== */
#page-tasks thead th,#page-tasks tbody td{vertical-align:middle;text-align:left}
#page-tasks tbody td{padding:12px 12px}
#page-tasks thead th{padding:11px 12px;text-align:left}
#page-tasks tbody td>div{vertical-align:middle}
#page-tasks tbody .s-ava{margin:0 0 auto} /* D4-002 对齐表头：清除 auto 水平外边距 */
thead th{text-align:left;font-size:11px;color:var(--txt-3);font-weight:600;padding:9px 10px;
  border-bottom:1px solid var(--line);white-space:nowrap}
tbody td{padding:11px 10px;border-bottom:1px solid rgba(120,150,220,.08);vertical-align:top}
tbody tr{cursor:pointer;transition:.2s}
tbody tr:hover{background:rgba(255,255,255,.03)}
.t-id{font-family:ui-monospace,Consolas;font-size:11.5px;color:var(--cyan)}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;padding:2px 10px;border-radius:999px;white-space:nowrap}
.pill i{width:5px;height:5px;border-radius:50%}
.p-done{color:var(--green);background:rgba(61,220,160,.1)}
.p-done i{background:var(--green)}
.p-busy{color:var(--cyan);background:rgba(56,225,255,.1)}
.p-busy i{background:var(--cyan)}
.p-wait{color:var(--amber);background:rgba(255,194,77,.1)}
.p-wait i{background:var(--amber)}
.p-stop{color:var(--red);background:rgba(255,107,122,.1)}
.p-stop i{background:var(--red)}
.cell-sub{font-size:11px;color:var(--txt-3);margin-top:2px}
.appr-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.appr{background:rgba(255,255,255,.035);border:1px solid var(--line);border-radius:13px;padding:14px 16px;transition:.25s}
.appr:hover{border-color:var(--line-strong)}
.appr .a-top{display:flex;justify-content:space-between;font-size:11px;color:var(--txt-3)}
.a-id{font-family:ui-monospace,Consolas}
.appr h5{font-size:13.5px;margin:8px 0 5px}
.appr p{font-size:12px;color:var(--txt-2)}
.a-meta{display:flex;gap:14px;margin-top:10px;font-size:11.5px;color:var(--txt-3)}
.a-meta b{color:var(--amber)}
.a-btns{display:flex;gap:8px;margin-top:12px}
.a-btns button{flex:1;font-size:12px;border-radius:9px;padding:7px 0;cursor:pointer;border:1px solid var(--line)}
.btn-pass{background:linear-gradient(135deg,rgba(61,220,160,.22),rgba(61,220,160,.1));color:var(--green);border-color:rgba(61,220,160,.35)!important}
.btn-back{background:rgba(255,107,122,.08);color:var(--red);border-color:rgba(255,107,122,.3)!important}
.btn-view{background:rgba(255,255,255,.05);color:var(--txt-2)}
.graph-wrap{position:relative;height:640px;background:radial-gradient(700px 400px at 50% 40%,rgba(77,124,254,.10),transparent 70%);
  border:1px solid var(--line);border-radius:14px;overflow:hidden}
.graph-wrap svg{width:100%;height:100%}
.g-link{stroke:rgba(120,160,255,.18);stroke-width:1}
.g-link.hot{stroke:var(--cyan);stroke-width:1.6;stroke-dasharray:5 6;animation:dash 2s linear infinite}
.g-node circle{cursor:pointer;transition:.2s}
.g-node:hover circle{filter:brightness(1.3)}
.g-node text{fill:var(--txt-2);font-size:11px;text-anchor:middle;pointer-events:none}
.g-node.dim{opacity:.2}
.seminar-layout{display:grid;grid-template-columns:1fr 320px;gap:14px;height:640px}
.seminar-stage{background:var(--panel-2);border:1px solid var(--line);border-radius:14px;padding:18px;overflow-y:auto}
.sem-speaker{display:flex;gap:11px;margin-bottom:15px}
.sem-ava{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;font-weight:700;color:#fff;font-size:13px;flex:none}
.sem-card{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:4px 13px 13px 13px;padding:11px 15px;font-size:13px}
.sem-who{font-size:11px;color:var(--cyan);margin-bottom:4px;font-weight:700}
.sem-side{background:var(--panel-2);border:1px solid var(--line);border-radius:14px;padding:16px}
.sem-side h4{font-size:14px;margin-bottom:12px}
