/* 知识图谱 · Obsidian 式力导向知识网络（Canvas 2D，零依赖） v6
 * 深色星空底（画布透明，页面星空透出）+ 中心枢纽 + 知识库 + 知识点
 * 力导向铺开、持续轻微流动；细连线可见；悬停/点击聚焦关联节点其余淡化
 * 拖拽节点、滚轮缩放、空白拖拽平移
 */
(function () {
  'use strict';
  var MOUNT = 'galaxyMount';
  var LIB_COLORS = ['#B6C2DA','#B6C2DA','#B6C2DA','#B6C2DA','#B6C2DA','#B6C2DA','#B6C2DA','#B6C2DA'];
  function hex2rgb(h){h=String(h||'').replace('#','');if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];var n=parseInt(h,16)||0;return [(n>>16&255)/255,(n>>8&255)/255,(n&255)/255];}
  function rgba(c,a){return 'rgba('+Math.round(c[0]*255)+','+Math.round(c[1]*255)+','+Math.round(c[2]*255)+','+(a==null?1:a)+')';}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];});}
  function h32(v){v=String(v||'');var h=2166136261;for(var i=0;i<v.length;i++){h^=v.charCodeAt(i);h=Math.imul(h,16777619);}return (h>>>0)/4294967296;}

  window.__startGraphForce = function () {
    var mount = document.getElementById(MOUNT);
    if (!mount) return false;
    if (mount.dataset.gfInit) return true;
    mount.dataset.gfInit = '1';
    var data = window.__GALAXY_DATA__ || { whitelist: [], nodes: [], edges: [] };
    var libs = (data.whitelist || []).slice();

    var canvas = document.createElement('canvas');
    canvas.style.cssText = 'width:100%;height:100%;display:block;background:transparent;cursor:grab';
    var ctx = canvas.getContext('2d');
    mount.appendChild(canvas);

    var W = 1, H = 1, DPR = 1;
    function size() {
      DPR = Math.max(1, window.devicePixelRatio || 1);
      W = mount.clientWidth || window.innerWidth;
      H = mount.clientHeight || window.innerHeight;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    size();
    window.__galaxyResize = size;

    var nodes = [], edges = [], byId = {}, links = {};
    function link(a, b) {
      if (!a || !b || a === b) return;
      if (links[a.id] && links[a.id][b.id]) return;
      edges.push({ a: a, b: b });
      (links[a.id] = links[a.id] || {})[b.id] = 1;
      (links[b.id] = links[b.id] || {})[a.id] = 1;
    }
    var root = { id: 'ROOT', label: '知识总库', kind: 'root', color: [0.93, 0.96, 1.0], r: 6, mass: 4, x: 0, y: 0, vx: 0, vy: 0 };
    nodes.push(root); byId[root.id] = root;
    libs.forEach(function (ds, i) {
      var n = { id: 'LIB:' + ds, label: ds, kind: 'lib', lib: i, color: hex2rgb(LIB_COLORS[i % LIB_COLORS.length]), r: 4, mass: 2, x: 0, y: 0, vx: 0, vy: 0 };
      nodes.push(n); byId[n.id] = n; link(root, n);
    });
    (data.nodes || []).forEach(function (s) {
      var li = Math.max(0, libs.indexOf(s.dataset));
      var n = { id: s.id, label: (s.display_name || s.doc || s.id), kind: 'seg', lib: li, color: hex2rgb(LIB_COLORS[li % LIB_COLORS.length]), r: 3, mass: 1, x: 0, y: 0, vx: 0, vy: 0, doc: s.doc || '', preview: s.preview || '' };
      nodes.push(n); byId[n.id] = n; link(byId['LIB:' + s.dataset], n);
    });
    (data.edges || []).forEach(function (e) { link(byId[e[0]], byId[e[1]]); });
    var N = nodes.length;

    (function init() {
      var R = Math.min(W, H) * 0.30;
      libs.forEach(function (ds, i) { var a = i / Math.max(1, libs.length) * 6.283 - 1.5708; var n = byId['LIB:' + ds]; n.x = Math.cos(a) * R; n.y = Math.sin(a) * R; });
      (data.nodes || []).forEach(function (s) {
        var li = Math.max(0, libs.indexOf(s.dataset)); var a = li / Math.max(1, libs.length) * 6.283 - 1.5708;
        var n = byId[s.id]; n.x = Math.cos(a) * R * 1.4 + (h32('x' + s.id) - 0.5) * 110; n.y = Math.sin(a) * R * 1.4 + (h32('y' + s.id) - 0.5) * 110;
      });
    })();

    var REP = 9000, SPR = 0.028, REST = 96, GRAV = 0.012, DAMP = 0.90, MAXV = 24;
    var dragNode = null;
    function step() {
      var i, j, n, m, dx, dy, d2, d, f, fx, fy;
      for (i = 0; i < N; i++) { nodes[i].fx = 0; nodes[i].fy = 0; }
      for (i = 0; i < N; i++) for (j = i + 1; j < N; j++) {
        n = nodes[i]; m = nodes[j];
        dx = n.x - m.x; dy = n.y - m.y; d2 = dx * dx + dy * dy + 0.01; d = Math.sqrt(d2);
        f = REP * (n.mass * m.mass) / d2; if (f > 60) f = 60;
        fx = dx / d * f; fy = dy / d * f;
        n.fx += fx; n.fy += fy; m.fx -= fx; m.fy -= fy;
      }
      for (i = 0; i < edges.length; i++) {
        n = edges[i].a; m = edges[i].b;
        dx = n.x - m.x; dy = n.y - m.y; d = Math.max(0.01, Math.sqrt(dx * dx + dy * dy));
        f = SPR * (d - REST);
        fx = dx / d * f; fy = dy / d * f;
        n.fx -= fx; n.fy -= fy; m.fx += fx; m.fy += fy;
      }
      for (i = 0; i < N; i++) {
        n = nodes[i];
        n.fx -= n.x * GRAV * n.mass; n.fy -= n.y * GRAV * n.mass;
        if (dragNode === n) { n.vx = 0; n.vy = 0; continue; }
        n.vx = (n.vx + n.fx) * DAMP; n.vy = (n.vy + n.fy) * DAMP;
        if (n.vx > MAXV) n.vx = MAXV; else if (n.vx < -MAXV) n.vx = -MAXV;
        if (n.vy > MAXV) n.vy = MAXV; else if (n.vy < -MAXV) n.vy = -MAXV;
        n.x += n.vx; n.y += n.vy;
      }
    }
    for (var w = 0; w < 260; w++) step();

    var cam = { z: 1, x: 0, y: 0 };
    function SX(wx) { return (wx - cam.x) * cam.z + W / 2; }
    function SY(wy) { return (wy - cam.y) * cam.z + H / 2; }
    function WX(px) { return (px - W / 2) / cam.z + cam.x; }
    function WY(py) { return (py - H / 2) / cam.z + cam.y; }

    var hover = null, sel = null, panning = false, moved = false, px0 = 0, py0 = 0, sx0 = 0, sy0 = 0, down = false;
    function nodeAt(mx, my) {
      var best = null, bd = 1e9;
      for (var i = 0; i < N; i++) {
        var n = nodes[i], dx = SX(n.x) - mx, dy = SY(n.y) - my, dd = Math.sqrt(dx * dx + dy * dy);
        var rr = n.r * cam.z + 7;
        if (dd < rr && dd < bd) { bd = dd; best = n; }
      }
      return best;
    }
    canvas.addEventListener('pointerdown', function (e) {
      var r = mount.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top;
      down = true; moved = false; px0 = mx; py0 = my; sx0 = mx; sy0 = my;
      var hit = nodeAt(mx, my);
      if (hit) dragNode = hit; else panning = true;
      canvas.style.cursor = 'grabbing';
    });
    window.addEventListener('pointermove', function (e) {
      var r = mount.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top;
      if (down && (Math.abs(mx - sx0) + Math.abs(my - sy0) > 4)) moved = true;
      if (down && dragNode) { dragNode.x = WX(mx); dragNode.y = WY(my); }
      else if (down && panning) { cam.x -= (mx - px0) / cam.z; cam.y -= (my - py0) / cam.z; }
      px0 = mx; py0 = my;
      hover = down ? hover : nodeAt(mx, my);
      canvas.style.cursor = hover ? 'pointer' : 'grab';
    });
    window.addEventListener('pointerup', function () {
      if (dragNode && !moved) onSelect(dragNode);
      dragNode = null; panning = false; down = false; canvas.style.cursor = 'grab';
    });
    canvas.addEventListener('wheel', function (e) {
      e.preventDefault();
      var f = e.deltaY < 0 ? 1.12 : 0.89;
      cam.z = Math.min(3.2, Math.max(0.4, cam.z * f));
    }, { passive: false });

    var tip = null;
    function ensureTip() { if (tip) return tip; tip = document.createElement('div'); tip.style.cssText = 'position:absolute;z-index:5;max-width:240px;padding:9px 12px;border-radius:10px;font-size:11.5px;line-height:1.5;color:#EAF0FF;background:rgba(10,15,32,.92);border:1px solid rgba(120,160,255,.3);box-shadow:0 8px 26px rgba(0,0,0,.5);display:none;pointer-events:none'; mount.appendChild(tip); return tip; }
    function onSelect(n) {
      var t = ensureTip();
      var deg = links[n.id] ? Object.keys(links[n.id]).length : 0;
      if (n.kind === 'seg') t.innerHTML = '<div style="font-weight:700;color:' + rgba(n.color, 1) + ';margin-bottom:3px">' + esc(n.label) + '</div><div style="font-size:11px;color:#9AA7C7">库：' + esc(libs[n.lib] || '') + ' · ' + deg + ' 条关联</div>' + (n.preview ? '<div style="margin-top:5px;color:#5E6B8D;font-size:10.5px">' + esc(n.preview) + '</div>' : '');
      else if (n.kind === 'lib') t.innerHTML = '<div style="font-weight:700;color:' + rgba(n.color, 1) + '">' + esc(n.label) + '</div><div style="color:#9AA7C7;margin-top:3px">' + deg + ' 个知识条目</div>';
      else t.innerHTML = '<div style="font-weight:700;color:#EAF0FF">' + esc(n.label) + '</div><div style="color:#9AA7C7;margin-top:3px">共 ' + N + ' 节点</div>';
      t.style.display = 'block'; t.style.left = '16px'; t.style.top = '14px'; sel = n;
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      var focus = hover || sel, rel = null;
      if (focus) { rel = {}; rel[focus.id] = 1; var ks = links[focus.id] ? Object.keys(links[focus.id]) : []; for (var q = 0; q < ks.length; q++) rel[ks[q]] = 1; }
      var tnow = performance.now() / 1000;
      for (var e = 0; e < edges.length; e++) {
        var en = edges[e], x1 = SX(en.a.x), y1 = SY(en.a.y), x2 = SX(en.b.x), y2 = SY(en.b.y);
        var active = focus && rel[en.a.id] && rel[en.b.id];
        ctx.strokeStyle = active ? 'rgba(186,202,232,.5)' : 'rgba(138,150,176,' + (focus ? 0.04 : 0.20) + ')';
        ctx.lineWidth = active ? 1 : 0.8;
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
        if (!focus || active) { var ph = (tnow * 0.35 + h32(en.a.id + en.b.id)) % 1; ctx.globalAlpha = active ? 1 : 0.8; ctx.fillStyle = 'rgba(196,212,240,.55)'; ctx.beginPath(); ctx.arc(x1 + (x2 - x1) * ph, y1 + (y2 - y1) * ph, 1.2, 0, 6.283); ctx.fill(); ctx.globalAlpha = 1; }
      }
      for (var i = 0; i < N; i++) {
        var n = nodes[i], x = SX(n.x), y = SY(n.y), rr = Math.max(2.2, n.r * cam.z);
        var on = !focus || rel[n.id];
        ctx.globalAlpha = (focus && !on) ? 0.16 : 1;
        ctx.shadowBlur = 0;
        ctx.beginPath(); ctx.arc(x, y, rr, 0, 6.283);
        ctx.fillStyle = n.kind === 'root' ? 'rgba(240,246,255,.95)' : 'rgba(196,207,228,.92)';
        ctx.fill(); ctx.shadowBlur = 0;
        if (focus === n) { ctx.lineWidth = 1.6; ctx.strokeStyle = 'rgba(235,242,255,.95)'; ctx.beginPath(); ctx.arc(x, y, rr + 4, 0, 6.283); ctx.stroke(); }
      }
      ctx.globalAlpha = 1;
      var showLabels = cam.z >= 1.1;
      for (var k = 0; k < N; k++) {
        var m = nodes[k]; if (!showLabels && focus !== m) continue;
        var lx = SX(m.x), ly = SY(m.y);
        var on2 = !focus || rel[m.id];
        ctx.globalAlpha = (focus && !on2) ? 0.16 : 1;
        ctx.font = (m.kind === 'root' || m.kind === 'lib' ? '600 12px ' : '400 11px ') + '"PingFang SC","Microsoft YaHei",sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'top';
        ctx.fillStyle = m.kind === 'root' ? 'rgba(236,242,255,.98)' : ((focus === m) ? 'rgba(226,234,250,.98)' : 'rgba(178,192,216,.9)');
        ctx.fillText(m.label, lx, ly + Math.max(2.2, m.r * cam.z) + 5);
      }
      ctx.globalAlpha = 1;
    }
    function loop() { step(); draw(); requestAnimationFrame(loop); }
    requestAnimationFrame(loop);
    window.__galaxyReady = true;
    window.__galaxyInfo = { nodes: N, edges: edges.length };
    return true;
  };
})();







