/* 知识图谱页 · Obsidian 风格力导向知识云（Canvas 2D，零依赖） v4
 * 稳定版：环形星团布局 + 每节点轨道漂移（呼吸）+ 悬停/拖拽/缩放
 */
(function(){
  var MOUNT='galaxyMount';
  var libColors=['#69E7FF','#B39DFF','#FF9BD2','#62FAD3','#F5C66B','#FFA48F'];
  function hex2rgb(h){h=h.replace('#','');if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];var n=parseInt(h,16);return [(n>>16&255)/255,(n>>8&255)/255,(n&255)/255];}
  function rgbStr(a){return 'rgb('+Math.round(a[0]*255)+','+Math.round(a[1]*255)+','+Math.round(a[2]*255)+')';}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];});}
  function hash(v){v=String(v||'');var h=2166136261;for(var i=0;i<v.length;i++){h^=v.charCodeAt(i);h=Math.imul(h,16777619);}return h>>>0;}

  window.__startGraphForce=function(){
    var mount=document.getElementById(MOUNT);
    if(!mount)return false;
    if(mount.dataset.gfStarted)return true;
    mount.dataset.gfStarted='1';
    var data=window.__GALAXY_DATA__||{whitelist:[],nodes:[],edges:[]};

    var canvas=document.createElement('canvas');
    canvas.style.cssText='width:100%;height:100%;display:block;background:transparent';
    var ctx=canvas.getContext('2d');
    mount.appendChild(canvas);
    var W=1,H=1,dpr=1;
    function sizeCanvas(){dpr=Math.max(1,window.devicePixelRatio||1);W=mount.clientWidth||window.innerWidth;H=mount.clientHeight||window.innerHeight;canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);}
    sizeCanvas();

    /* ---------- 数据 ---------- */
    var libs=[].concat(data.whitelist||[]);
    var nodes=[]; var byId={};
    var baseR=Math.min(W,H)*0.42;
    var libR=baseR;                       // 库环半径
    function C(cx,cy,r,ang){return [cx+r*Math.cos(ang),cy+r*Math.sin(ang)];}

    // 总库（中心）
    var root={id:'ROOT',label:'Vincent 工作室 · 知识总库',kind:'root',home:[0,0],orbit:0,phase:0,speed:0,r:34,blog:0.5,color:[0.91,0.96,1],sub:nodes.length};
    nodes.push(root);byId[root.id]=root;var nRoot=1;

    // 库节点均匀绕一环
    var libNodes={};
    libs.forEach(function(ds,i){
      var ang=i/libs.length*Math.PI*2;
      var p=C(0,0,libR,ang);
      var n={id:'LIB:'+ds,label:'『'+ds+'』',lib:i,kind:'lib',home:p,orbit:16,phase:hash('lib'+i)/4294967296*Math.PI*2,speed:0.10+hash('s'+i)%5*0.012,r:21,blog:0.6,color:hex2rgb(libColors[i%libColors.length]),raw:[i,ang]};
      nodes.push(n);libNodes[ds]=n;byId[n.id]=n;
    });

    // 片段节点：绕各自库聚成小星群
    data.nodes.forEach(function(s){
      var li=Math.max(0,libs.indexOf(s.dataset));
      var neste=libR*0.30; // 片段环半径(相对库)
      var ang=(i=0,0);
      var g=hash(s.id);
      var ang=(g/4294967296)*Math.PI*2 + ((data.edges||[]).indexOf?0:0);
      // 让同库片段错开角
      var cnt=nodes.filter(function(x){return x.kind==='seg'&&x.lib===li;}).length;
      var slot=cnt;
      var a=(slot/libs.length*Math.PI*2);
      var p=C(0,0,neste*0.8,a);
      var n={id:s.id,label:s.display_name||s.doc||s.id,doc:s.doc||'',lib:li,kind:'seg',home:p,orbit:7,phase:(g%3600)/3600*Math.PI*2,speed:0.16+ (g%5)*0.015,r:8,blog:0.7,color:hex2rgb(libColors[li%libColors.length]),preview:s.preview||''};
      nodes.push(n);byId[n.id]=n;
    });

    // 修正：片段初始应围绕所属库（在全局坐标上叠加库位置）
    // 上面的 home 是相对中心，现改为绝对：home = libPos + rel
    // (因为库 home 在 libR 环上，片段堆在中心不合理) —— 重新定位
    var libPos={};
    libs.forEach(function(ds,i){var a=i/libs.length*Math.PI*2;libPos[ds]=C(0,0,libR,a);});
    data.nodes.forEach(function(s,idx){
      var li=Math.max(0,libs.indexOf(s.dataset));
      var nestR=libR*0.30;
      var cnt=0;for(var k=0;k<idx;k++){if(data.nodes[k].dataset===s.dataset)cnt++;}
      var a=(cnt*2.39996 + li*0.8); // 哈希错开
      var rel=C(0,0,nestR,a);
      nodes[nRoot+1+idx].home=[libPos[s.dataset][0]+rel[0], libPos[s.dataset][1]+rel[1]];
    });

    // 边
    var edges=[];
    function add(a,b){if(a&&b)edges.push({a:a,b:b});}
    libs.forEach(function(ds){add(root,byId['LIB:'+ds]);});
    data.nodes.forEach(function(s){add(byId['LIB:'+s.dataset],byId[s.id]);});
    (data.edges||[]).forEach(function(e){add(byId[e[0]],byId[e[1]]);});

    /* ---------- 相机 ---------- */
    var cam={z:1}; var drag=null,down=false,moved=false,px=0,py=0,sx=0,sy=0,hover=null,sel=null;
    var offset={x:0,y:0};
    function toWorld(mx,my){return {x:(mx-W/2)/cam.z+offset.x,y:(my-H/2)/cam.z+offset.y};}
    function toScreen(wx,wy){return {x:wx*cam.z+W/2-offset.x*cam.z,y:wy*cam.z+H/2-offset.y*cam.z};}
    canvas.addEventListener('pointerdown',function(e){down=true;moved=false;sx=e.clientX;sy=e.clientY;var r=mount.getBoundingClientRect();var w=toWorld(e.clientX-r.left,e.clientY-r.top);var hit=nodeAt(w);drag=hit||'pan';px=(e.clientX-r.left);py=(e.clientY-r.top);});
    window.addEventListener('pointermove',function(e){
      var r=mount.getBoundingClientRect(),mx=e.clientX-r.left,my=e.clientY-r.top;
      if(down&&Math.hypot(e.clientX-sx,e.clientY-sy)>3)moved=true;
      if(down&&drag==='pan'){offset.x-=(e.clientX-px)/cam.z;offset.y-=(e.clientY-py)/cam.z;}
      if(down&&drag&&drag!=='pan'){var w=toWorld(mx,my);drag.home[0]=w.x;drag.home[1]=w.y;}
      px=e.clientX-r.left;py=e.clientY-r.top;hover=nodeAt(toWorld(mx,my));
    });
    window.addEventListener('pointerup',function(){if(drag&&drag!=='pan'&&!moved)onSelect(drag);drag=null;down=false;});
    canvas.addEventListener('wheel',function(e){e.preventDefault();var f=e.deltaY<0?1.1:0.9;cam.z=Math.min(2.4,Math.max(0.5,cam.z*f));},{passive:false});
    function nodeAt(w){var best=null,bd=1e9;for(var i=0;i<nodes.length;i++){var dx=nodes[i].home[0]-w.x,dy=nodes[i].home[1]-w.y;var d=Math.sqrt(dx*dx+dy*dy);var rr=nodes[i].r+5;if(d<rr&&d<bd){bd=d;best=nodes[i];}}return best;}

    /* ---------- 详情 ---------- */
    var tip=null;
    function ensureTip(){if(tip)return tip;tip=document.createElement('div');tip.style.cssText='position:absolute;z-index:5;max-width:250px;padding:10px 13px;border-radius:10px;font-size:11.5px;line-height:1.5;color:#EAF0FF;background:rgba(9,14,30,.94);border:1px solid rgba(120,160,255,.32);box-shadow:0 8px 26px rgba(0,0,0,.5);display:none;pointer-events:none';mount.appendChild(tip);return tip;}
    function countIn(n){var c=0;for(var i=0;i<nodes.length;i++)if(nodes[i].kind==='seg'&&nodes[i].lib===n.lib)c++;return c;}
    function onSelect(n){
      var t=ensureTip();var r=mount.getBoundingClientRect();
      if(n.kind==='seg'){t.innerHTML='<div style="font-weight:700;color:'+rgbStr(n.color)+';margin-bottom:3px">'+esc(n.label)+'</div><div style="font-size:11px;color:#9AA7C7">库：'+esc(libs[n.lib]||'')+'</div>'+(n.preview?'<div style="margin-top:5px;color:#5E6B8D;font-size:10.5px">'+esc(n.preview)+'</div>':'');}
      else if(n.kind==='lib'){t.innerHTML='<div style="font-weight:700;color:'+rgbStr(n.color)+'">'+esc(n.label)+'</div><div style="color:#9AA7C7;margin-top:3px">核心知识库 · '+countIn(n)+' 条知识条目</div>';}
      else{t.innerHTML='<div style="font-weight:700;color:#EAF0FF">'+esc(n.label)+'</div><div style="color:#9AA7C7;margin-top:3px">知识总库 '+nodes.length+' 节点</div>';}
      t.style.display='block';t.style.left='16px';t.style.top='14px';sel=n;
    }

    /* ---------- 渲染：轨道漂移 ---------- */
    var t0=performance.now();
    function orbit(n,t,now){
      var p=C(0,0,n.orbit,n.phase+now*0.0002*n.speed*60);
      return [n.home[0]+p[0],n.home[1]+p[1]];
    }
    function shortLabel(s){s=String(s||'');if(s.length>9)return s.slice(0,9)+'…';return s;}
    function draw(t){
      ctx.clearRect(0,0,W,H);
      var now=t-t0;
      // 边
      ctx.strokeStyle='rgba(120,160,255,.12)';ctx.lineWidth=1;
      for(var e=0;e<edges.length;e++){
        var a=toScreen.apply(null,orbit(edges[e].a,t,now)),b=toScreen.apply(null,orbit(edges[e].b,t,now));
        ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();
      }
      // 节点
      var i,n,s,rr,isH,isS,label;
      for(i=0;i<nodes.length;i++){
        n=nodes[i];s=toScreen.apply(null,orbit(n,t,now));isH=(hover===n);isS=(sel===n);
        rr=n.r+(isH||isS?7:0);
        if(n.kind==='root'){
          ctx.globalAlpha=1;ctx.shadowColor=rgbStr(n.color);ctx.shadowBlur=38;
          ctx.beginPath();ctx.arc(s.x,s.y,rr,0,6.283);ctx.fillStyle='rgba(232,244,255,.16)';ctx.fill();ctx.shadowBlur=0;
          ctx.beginPath();ctx.arc(s.x,s.y,rr,0,6.283);ctx.strokeStyle=rgbStr(n.color);ctx.lineWidth=2;ctx.stroke();
        }else{
          ctx.shadowColor=rgbStr(n.color);ctx.shadowBlur=isH?16:6;ctx.globalAlpha=isH?1:0.9;
          ctx.beginPath();ctx.arc(s.x,s.y,rr,0,6.283);ctx.fillStyle=rgbStr(n.color);ctx.fill();ctx.shadowBlur=0;
        }
        ctx.globalAlpha=1;
        // 标签：库常显；根/片段在放大或悬停时显示
        if(n.kind==='lib'||isH||isS||cam.z>1.25||n.kind==='root'&&cam.z<0.7){
          if(isH&&n.kind==='seg'){ctx.font='600 11px "PingFang SC","Microsoft YaHei",sans-serif';ctx.textAlign='center';ctx.textBaseline='top';var tw=n.label.length*6;ctx.fillStyle='rgba(9,14,30,.92)';ctx.fillRect(s.x-tw/2-5,s.y-rr-24,tw+10,21);ctx.fillStyle=rgbStr(n.color);ctx.fillText(n.label,s.x,s.y-rr-19);}
          else{
            ctx.font=(n.kind==='root'?'700 ':'500 ')+((n.kind==='lib'||n.kind==='root')?13:11)+'px "PingFang SC","Microsoft YaHei",sans-serif';
            ctx.textAlign='center';ctx.textBaseline='top';
            label=n.kind==='seg'?shortLabel(n.label):n.label;
            ctx.fillStyle=(n.kind==='lib'||n.kind==='root')?rgbStr(n.color):(isH?'#fff':'rgba(200,206,236,.7)');
            ctx.fillText(label,s.x,s.y+rr+7);
          }
        }
      }
    }
    function loop(t){draw(t);requestAnimationFrame(loop);}
    requestAnimationFrame(loop);

    window.__galaxyResize=sizeCanvas;window.__galaxyReady=true;
    return true;
  };
})();
