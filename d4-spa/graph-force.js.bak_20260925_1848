/* 知识图谱 · 中心放射 + 真实关系网（Canvas 2D，零依赖） v12
 * 结构：中心「知识总库」为唯一中心，22 个文档直连中心；3 个知识库内层金色标识。
 *       默认只显示高层节点；放大或聚焦后，362 个片段各自直连中心，
 *       并叠加 galaxy.json 中真实的 340 条片段关系边（点与点之间的联系）。
 * 手感：弹簧物理——拖动节点时相连节点被拉扯跟随，松手回弹归位；可拖拽、滚轮缩放、空白平移。
 * 配色对齐 Obsidian 式定稿：中心冷银白 #E8F4FF，知识库金黄 #F5C66B，文档青蓝 #8FD3FF。
 */
(function () {
  'use strict';
  var MOUNT = 'galaxyMount';
  var ROOT_COLOR = '#E8F4FF';
  var LIB_COLOR = '#F5C66B';
  var DOC_COLOR = '#8FD3FF';
  var SEG_COLOR = '#B6C2DA';
  function hex2rgb(h){h=String(h||'').replace('#','');if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];var n=parseInt(h,16)||0;return [(n>>16&255)/255,(n>>8&255)/255,(n&255)/255];}
  function rgba(c,a){return 'rgba('+Math.round(c[0]*255)+','+Math.round(c[1]*255)+','+Math.round(c[2]*255)+','+(a==null?1:a)+')';}
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];});}
  function h32(v){v=String(v||'');var h=2166136261;for(var i=0;i<v.length;i++){h^=v.charCodeAt(i);h=Math.imul(h,16777619);}return (h>>>0)/4294967296;}

  window.__startGraphForce = function () {
    var mount = document.getElementById(MOUNT);
    if (!mount) return false;
    if (mount.dataset.gfInit) return true;
    mount.dataset.gfInit = '1';
    var data = window.__GALAXY_DATA__ || { whitelist: [], nodes: [], edges: [] };
    var libs = (data.whitelist || []).slice();
    var rootCol = hex2rgb(ROOT_COLOR);
    var libCol = hex2rgb(LIB_COLOR);
    var docCol = hex2rgb(DOC_COLOR);
    var segCol = hex2rgb(SEG_COLOR);

    var canvas = document.createElement('canvas');
    canvas.style.cssText = 'width:100%;height:100%;display:block;background:transparent;cursor:grab';
    var ctx = canvas.getContext('2d');
    mount.appendChild(canvas);

    var W=1,H=1,DPR=1;
    function size(){
      DPR=Math.max(1,window.devicePixelRatio||1);
      W=mount.clientWidth||window.innerWidth;
      H=mount.clientHeight||window.innerHeight;
      canvas.width=Math.round(W*DPR); canvas.height=Math.round(H*DPR);
      ctx.setTransform(DPR,0,0,DPR,0,0);
      layout();
    }
    window.__galaxyResize=size;

    var nodes=[], edges=[], byId={}, links={};
    function mk(o){ o.x=0;o.y=0;o.vx=0;o.vy=0;o.fx=0;o.fy=0; return o; }
    var root=mk({ id:'ROOT', label:'知识总库', kind:'root', r:6.5, home:[0,0] });
    nodes.push(root); byId[root.id]=root;

    // 3 个知识库：内层金色标识，直连中心
    libs.forEach(function(ds,i){
      var n=mk({ id:'LIB:'+ds, label:ds, kind:'lib', lib:i, r:4.5, home:[0,0] });
      nodes.push(n); byId[n.id]=n;
      edges.push({a:root,b:n,rest:0});
      (links[root.id]=links[root.id]||{})[n.id]=1;
      (links[n.id]=links[n.id]||{})[root.id]=1;
    });

    var src=(data.nodes||[]);
    var docMap={}, docSegs={};
    src.forEach(function(s){
      var dk=s.doc||'未分组';
      var d=docMap[dk];
      if(!d){
        var li=Math.max(0,libs.indexOf(s.dataset));
        d=docMap[dk]={ id:'DOC:'+dk, label:dk, kind:'doc', lib:li, r:3.8, home:[0,0], segs:0 };
        nodes.push(d); byId[d.id]=d;
        // 所有点直连中心：文档直接连中心
        edges.push({a:root,b:d,rest:0});
        (links[root.id]=links[root.id]||{})[d.id]=1;
        (links[d.id]=links[d.id]||{})[root.id]=1;
      }
      d.segs++;
    });
    var docKeys=Object.keys(docMap);

    src.forEach(function(s){
      var dk=s.doc||'未分组';
      var d=docMap[dk];
      var n=mk({ id:s.id, label:(s.display_name||s.doc||s.id), kind:'seg', doc:d.id, lib:d.lib, r:2.2, home:[0,0], preview:s.preview||'' });
      nodes.push(n); byId[n.id]=n;
      // 所有点直连中心：片段也直连中心
      edges.push({a:root,b:n,rest:0});
      (links[root.id]=links[root.id]||{})[n.id]=1;
      (links[n.id]=links[n.id]||{})[root.id]=1;
      // 逻辑归属：用于聚焦高亮和文档计数
      (docSegs[d.id]=docSegs[d.id]||{})[n.id]=1;
      (links[d.id]=links[d.id]||{})[n.id]=1;
      (links[n.id]=links[n.id]||{})[d.id]=1;
    });

    // 点与点之间的真实关系边（galaxy.json.edges）
    var realN=0;
    (data.edges||[]).forEach(function(p){
      if(!p||p.length<2) return;
      var a=byId[p[0]], b=byId[p[1]];
      if(!a||!b||a.id===b.id) return;
      if(links[a.id]&&links[a.id][b.id]) return; // 去重
      edges.push({a:a,b:b,rest:0,real:true});
      (links[a.id]=links[a.id]||{})[b.id]=1;
      (links[b.id]=links[b.id]||{})[a.id]=1;
      realN++;
    });
    var N=nodes.length;

    function polar(r,a){return [Math.cos(a)*r, Math.sin(a)*r];}
    function layout(){
      var m=Math.min(W,H), R0=m*0.15, R1=m*0.40, R3=m*0.055;
      root.home=[0,0];
      libs.forEach(function(ds,i){
        var lib=byId['LIB:'+ds]; if(!lib) return;
        lib.home=polar(R0, -Math.PI/2 + i*(Math.PI*2/Math.max(1,libs.length)));
      });
      // 22 个文档绕中心均匀分布，单中心放射
      docKeys.forEach(function(dk,k){
        var d=docMap[dk];
        d.home=polar(R1, -Math.PI/2 + k*(Math.PI*2/Math.max(1,docKeys.length)));
      });
      // 362 个片段在所属文档附近成云展开
      nodes.forEach(function(n){
        if(n.kind!=='seg') return;
        var d=byId[n.doc]; if(!d) return;
        var ang=h32(n.id)*Math.PI*2;
        var rad=Math.sqrt(h32(n.id+'r'))*R3;
        n.home=[ d.home[0]+Math.cos(ang)*rad, d.home[1]+Math.sin(ang)*rad ];
      });
      for(var i=0;i<N;i++){ var n=nodes[i]; n.x=n.home[0]; n.y=n.home[1]; n.vx=0; n.vy=0; }
      for(var e=0;e<edges.length;e++){ var en=edges[e]; en.rest=Math.hypot(en.a.home[0]-en.b.home[0], en.a.home[1]-en.b.home[1]); }
    }

    var KH=0.030, KE=0.16, DAMP=0.85, MAXV=18;
    function step(){
      var i,n,m,e,dx,dy,d,f,fx,fy;
      for(i=0;i<N;i++){ n=nodes[i]; n.fx=(n.home[0]-n.x)*KH; n.fy=(n.home[1]-n.y)*KH; }
      for(i=0;i<edges.length;i++){
        e=edges[i]; n=e.a; m=e.b;
        dx=m.x-n.x; dy=m.y-n.y; d=Math.max(0.01,Math.sqrt(dx*dx+dy*dy));
        f=KE*(d-e.rest); fx=dx/d*f; fy=dy/d*f;
        n.fx+=fx; n.fy+=fy; m.fx-=fx; m.fy-=fy;
      }
      for(i=0;i<N;i++){
        n=nodes[i];
        if(dragNode===n){ n.vx=0; n.vy=0; continue; }
        n.vx=(n.vx+n.fx)*DAMP; n.vy=(n.vy+n.fy)*DAMP;
        if(n.vx>MAXV)n.vx=MAXV; else if(n.vx<-MAXV)n.vx=-MAXV;
        if(n.vy>MAXV)n.vy=MAXV; else if(n.vy<-MAXV)n.vy=-MAXV;
        n.x+=n.vx; n.y+=n.vy;
      }
    }

    var cam={z:1,x:0,y:0};
    function SX(wx){return (wx-cam.x)*cam.z+W/2;}
    function SY(wy){return (wy-cam.y)*cam.z+H/2;}
    function WX(sx){return (sx-W/2)/cam.z+cam.x;}
    function WY(sy){return (sy-H/2)/cam.z+cam.y;}

    var vis={};
    function segVisible(n,f){
      if(cam.z>=1.6) return true;
      if(!f) return false;
      if(f.kind==='doc') return !!docSegs[f.id]&&docSegs[f.id][n.id];
      if(f.kind==='seg') return n.doc===f.doc;
      return false;
    }
    function refreshVisibility(f){
      vis={};
      for(var i=0;i<N;i++){
        var n=nodes[i];
        vis[n.id] = n.kind==='seg' ? segVisible(n,f) : true;
      }
    }

    var hover=null,sel=null,dragNode=null,panning=false,moved=false,px0=0,py0=0,sx0=0,sy0=0,down=false;
    function nodeAt(mx,my){
      var f=hover||sel, best=null,bd=1e9;
      for(var i=0;i<N;i++){
        var n=nodes[i];
        if(n.kind==='seg'&&!segVisible(n,f)) continue;
        var dx=SX(n.x)-mx, dy=SY(n.y)-my;
        var dd=Math.sqrt(dx*dx+dy*dy);
        var rr=n.r*cam.z+7;
        if(dd<rr&&dd<bd){bd=dd;best=n;}
      }
      return best;
    }
    canvas.addEventListener('pointerdown',function(e){ var r=mount.getBoundingClientRect(), mx=e.clientX-r.left, my=e.clientY-r.top; down=true; moved=false; px0=mx;py0=my;sx0=mx;sy0=my; var hit=nodeAt(mx,my); if(hit) dragNode=hit; else panning=true; canvas.style.cursor='grabbing'; });
    window.addEventListener('pointermove',function(e){ var r=mount.getBoundingClientRect(), mx=e.clientX-r.left, my=e.clientY-r.top; if(down&&(Math.abs(mx-sx0)+Math.abs(my-sy0)>4)) moved=true; if(down&&dragNode){ dragNode.x=WX(mx); dragNode.y=WY(my); } else if(down&&panning){ cam.x-=(mx-px0)/cam.z; cam.y-=(my-py0)/cam.z; } px0=mx;py0=my; hover= down?hover:nodeAt(mx,my); canvas.style.cursor= hover?'pointer':'grab'; });
    window.addEventListener('pointerup',function(){ if(dragNode&&!moved) onSelect(dragNode); dragNode=null; panning=false; down=false; canvas.style.cursor='grab'; });
    canvas.addEventListener('wheel',function(e){ e.preventDefault(); var f=e.deltaY<0?1.12:0.89; cam.z=Math.min(3.2,Math.max(0.4,cam.z*f)); },{passive:false});

    var tip=null;
    function ensureTip(){ if(tip) return tip; tip=document.createElement('div'); tip.style.cssText='position:absolute;z-index:5;max-width:240px;padding:9px 12px;border-radius:10px;font-size:11.5px;line-height:1.5;color:#EAF0FF;background:rgba(10,15,32,.92);border:1px solid rgba(120,160,255,.3);box-shadow:0 8px 26px rgba(0,0,0,.5);display:none;pointer-events:none'; mount.appendChild(tip); return tip; }
    function onSelect(n){ var t=ensureTip();
      if(n.kind==='seg') t.innerHTML='<div style="font-weight:700;color:'+rgba(segCol,1)+';margin-bottom:3px">'+esc(n.label)+'</div><div style="font-size:11px;color:#9AA7C7">库：'+esc(libs[n.lib]||'')+'</div>'+(n.preview?'<div style="margin-top:5px;color:#5E6B8D;font-size:10.5px">'+esc(n.preview)+'</div>':'');
      else if(n.kind==='doc') t.innerHTML='<div style="font-weight:700;color:'+rgba(docCol,1)+'">'+esc(n.label)+'</div><div style="color:#9AA7C7;margin-top:3px">'+(n.segs||0)+' 个知识片段 · 滚轮放大展开</div><div style="color:#6A7694;margin-top:2px;font-size:10.5px">库：'+esc(libs[n.lib]||'')+'</div>';
      else if(n.kind==='lib') t.innerHTML='<div style="font-weight:700;color:'+rgba(libCol,1)+'">'+esc(n.label)+'</div><div style="color:#9AA7C7;margin-top:3px">'+(links[n.id]?Object.keys(links[n.id]).length-1:0)+' 个直属文档</div>';
      else t.innerHTML='<div style="font-weight:700;color:#EAF0FF">'+esc(n.label)+'</div><div style="color:#9AA7C7;margin-top:3px">共 '+(data.nodes||[]).length+' 个知识片段 · '+(realN||0)+' 条真实关系</div>';
      t.style.display='block'; t.style.left='16px'; t.style.top='14px'; sel=n; }

    function nodeColor(n){
      if(n.kind==='root') return rootCol;
      if(n.kind==='lib') return libCol;
      if(n.kind==='doc') return docCol;
      return segCol;
    }
    function draw(){
      ctx.clearRect(0,0,W,H);
      var focus=hover||sel, rel=null, tnow=performance.now()/1000;
      refreshVisibility(focus);
      if(focus){ rel={}; rel[focus.id]=1; var ks=links[focus.id]?Object.keys(links[focus.id]):[]; for(var q=0;q<ks.length;q++) rel[ks[q]]=1; }
      for(var e=0;e<edges.length;e++){
        var en=edges[e];
        if(!vis[en.a.id]||!vis[en.b.id]) continue;
        var x1=SX(en.a.x), y1=SY(en.a.y), x2=SX(en.b.x), y2=SY(en.b.y);
        var active=focus&&rel[en.a.id]&&rel[en.b.id];
        ctx.strokeStyle= active?'rgba(186,202,232,.55)':(en.real?'rgba(128,170,210,'+(focus?0.04:0.16)+')':'rgba(138,150,176,'+(focus?0.04:0.20)+')');
        ctx.lineWidth= en.real?0.7:(active?1:0.8);
        ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();
        if(!focus||active){ var ph=(tnow*0.35+h32(en.a.id+en.b.id))%1; ctx.globalAlpha= active?1:0.8; ctx.fillStyle='rgba(196,212,240,.55)'; ctx.beginPath(); ctx.arc(x1+(x2-x1)*ph, y1+(y2-y1)*ph, 1.2, 0, 6.283); ctx.fill(); ctx.globalAlpha=1; }
      }
      for(var i=0;i<N;i++){
        var n=nodes[i];
        if(!vis[n.id]) continue;
        var x=SX(n.x), y=SY(n.y), rr=Math.max(1.8,n.r*cam.z);
        var on=!focus||rel[n.id];
        ctx.globalAlpha=(focus&&!on)?0.16:1;
        ctx.beginPath(); ctx.arc(x,y,rr,0,6.283);
        ctx.fillStyle= rgba(nodeColor(n),0.95);
        ctx.fill();
        if(focus===n){ ctx.lineWidth=1.4; ctx.strokeStyle='rgba(235,242,255,.9)'; ctx.beginPath(); ctx.arc(x,y,rr+3.5,0,6.283); ctx.stroke(); }
      }
      ctx.globalAlpha=1;
      var showLabels = cam.z>=1.1;
      for(var k=0;k<N;k++){
        var m=nodes[k];
        if(!vis[m.id]) continue;
        if(!showLabels && focus!==m) continue;
        var lx=SX(m.x), ly=SY(m.y);
        var on2=!focus||rel[m.id];
        ctx.globalAlpha=(focus&&!on2)?0.16:1;
        ctx.font=(m.kind==='root'||m.kind==='lib'?'600 12px ':'400 11px ')+'"PingFang SC","Microsoft YaHei",sans-serif';
        ctx.textAlign='center'; ctx.textBaseline='top';
        ctx.fillStyle= m.kind==='root' ? 'rgba(236,242,255,.98)' : ((focus===m)?'rgba(226,234,250,.98)':'rgba(178,192,216,.9)');
        ctx.fillText(m.label, lx, ly+Math.max(1.8,m.r*cam.z)+5);
      }
      ctx.globalAlpha=1;
    }
    function loop(){ step(); draw(); requestAnimationFrame(loop); }
    size();
    requestAnimationFrame(loop);
    window.__galaxyReady=true;
    window.__galaxyInfo={ nodes:N, edges:edges.length, dataNodes:src.length, docs:docKeys.length, realEdges:realN };
    return true;
  };
})();
